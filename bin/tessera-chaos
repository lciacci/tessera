#!/usr/bin/env bash
# Spec 11 chaos probes — break a component on purpose, assert Tessera says so.
#
# THE BAR: break a component on purpose, and Tessera tells you within one session,
# without a human asking.
#
# **ALL 8 PROBES ARE GREEN as of 2026-07-26** — `tessera-degraded` and `tessera-watch` P13
# shipped, and the suite is now ALSO folded into `scripts/run-tests.sh` as the `chaos` run,
# so `tessera-test` covers it. **A red probe here is now a real regression in Tessera's
# ability to report its own failure, not the expected state.**
#
# It stayed a separate command while the probes were legitimately red, because a
# permanently-red main suite is one people learn to ignore. That reason has expired; the
# command is KEPT (not deleted) because running the probes in isolation is useful — they
# scaffold real downstream projects and take seconds, so `tessera-chaos` is the fast way to
# ask "does the framework still notice when I break it?" without the full suite.
#
# The suite lives at top-level `chaos/`, NOT `scripts/chaos/`, because run-tests.sh's
# top-level run is `pytest scripts/` — which would collect these and fail the main suite,
# the very thing this separate command exists to prevent. Excluding it instead would
# collide with doccheck's `ignored-test-suites-are-run`. Outside `scripts/`, no exclusion
# is needed and neither check gets weakened.
#
# The mechanism landed 2026-07-26 and the fold-in is done (`run "chaos"` in run-tests.sh).
# This script is deliberately kept rather than deleted — see the header. doccheck's
# `chaos-suite-is-reachable` still guards it against rotting unrun.
#
# Ordering is not style — spec 11 §ORDERING. The 2026-07-12 session built a detector, then
# verified the fix with the detector that had the hole, three times, and reported green
# each time. Watching these fail BEFORE the mechanism exists is the correction for that.
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1

# THE INTERPRETER IS A PATH, NOT A NAME (F-001). Same rule as run-tests.sh, same reason:
# a silent fallback to a toolchain-less interpreter is how F-001 stayed invisible for weeks.
PY="${TESSERA_PYTHON:-$PWD/.venv/bin/python}"
if [ ! -x "$PY" ]; then
    echo "FATAL: no toolchain interpreter at $PY" >&2
    echo "       Run ./install.sh to build the venv." >&2
    exit 1
fi

echo "Tessera chaos probes — spec 11"
echo "──────────────────────────────"
echo "All 8 green as of 2026-07-26. A RED probe here is a real regression: Tessera has"
echo "stopped reporting one of its own failures."
echo

"$PY" -m pytest chaos -q "$@"
rc=$?

echo
echo "──────────────────────────────"
if [ "$rc" -ne 0 ]; then
    echo "PROBES RED — REGRESSION. A component can now fail without saying so."
    echo "This was the expected state until 2026-07-26; it is not any more. A broken component"
    echo "is once again indistinguishable from a healthy one. See _project_specs/11-fail-open-detection.md."
else
    echo "PROBES GREEN — breaking a component on purpose still gets reported."
fi
exit "$rc"
