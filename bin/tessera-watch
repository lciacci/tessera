#!/usr/bin/env python3
"""tessera-watch — evaluate the Observatory's silent+machine-checkable triggers.

The Observatory's "When to revisit" conditions are prose: they fire only when a
human happens to re-read them, and on 2026-07-09 three sat past threshold
unnoticed (docs/observatory.md → "The Observatory's own triggers are prose").
This converts the five silent-AND-checkable triggers into predicates that check
themselves, surfaced via a SessionStart hook — a non-model channel, principle #17.

Substrate-only pilot (roadmap Tier 1 / spec 03 de-risk): a flat predicate list,
NO snooze/hysteresis/prose-parsing until a graduation predicate earns it. The
fired set is appended (with --log) to .tessera/logs/watch.jsonl — the fire-log
that also feeds the kill and graduate decisions. See _project_specs/todos/active.md.

    tessera-watch            # print fired predicates; exit 1 if any fire, else 0
    tessera-watch --json     # machine output
    tessera-watch --log      # append the run to the fire-log (the SessionStart hook passes this)
"""

# Runs on ANY python3 — including macOS's /usr/bin/python3 (3.9), which a PATH can hand
# you at any time. `#!/usr/bin/env python3` resolves a NAME, and the name's VERSION drifts
# with it. PEP-604 annotations (`str | None`) raise TypeError at definition time on 3.9.
# `from __future__ import annotations` makes them lazy strings. Do not remove.
from __future__ import annotations
import argparse
import json
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# ADR-0015 retired COMPACTION_MIN as a verdict threshold: it counted the rarest TRIGGER
# (~3 events) of a restore path that actually ran ~121 times, on every session start.
# RE-ANCHORED 2026-08-07. The old 12_000 rested on "18,755 was observed to SPILL" — an UPPER
# bound, the only spill anyone had seen — so it sat ABOVE the real limit and could report green
# on a checkpoint the model never received. Three tighter spills refuted it: 12,611b, 12,472b,
# 10,944b. The cap is DOCUMENTED at 10,000 CHARACTERS (code.claude.com/docs/en/hooks).
#
# THE FIRST RE-ANCHOR (9_500) WAS ALSO WRONG, and how it was wrong is the useful part.
# It came from `hook_stdout_bytes - checkpoint_bytes` = 105, reported as "wrapper overhead".
# That 105 was a NET of two errors cancelling: the RENDER is ~718 chars SMALLER than the JSON,
# and mnemos-session-start.sh emits a SECOND block on the same stdout — `=== iCPG STATUS ===`,
# ~1,037 chars. Measuring a difference and naming it a component. `bin/tessera-verify` refuted
# it with a decisive landmine: a checkpoint of EXACTLY 9,500b PASSED P3 and produced 10,230
# chars of hook stdout — over the cap, the very defect 12_000 had.
#
# Measured properly:
#   · render/JSON ratio is CONTENT-DEPENDENT: 0.598 to 0.944 observed. No constant is exact.
#   · non-checkpoint overhead on the same stdout: 1,250 chars (171 resume wrapper + iCPG block).
#   => worst case at ratio 1.0: 8,000 + 1,250 = 9,250, leaving 750 for iCPG-block growth.
#
# STILL A PROXY, stated rather than hidden: this measures checkpoint JSON bytes, and the
# delivered thing is rendered characters plus siblings. `bin/` is stdlib-only (doccheck
# `bin-scripts-are-stdlib-only`) so P3 cannot import the renderer. The honest instrument is
# the hook recording its own delivered size for P3 to read — see docs/observatory.md.
RESTORE_BUDGET_BYTES = 8_000    # see p3_restore_integrity
RESTORE_REQUIRED_FIELDS = ("goal", "active_constraints", "task_narrative")
SKILL_MIN = 60          # two-stage skill routing earns its keep at 60+ skills
GRADUATION_RUNS = 3     # a core predicate firing this many runs running → graduation-a
GATE_LABEL_MIN = 20     # unlabeled post-backstop gates before should_fire labeling earns its slot
BACKSTOP_LIVE = "2026-07-12"  # gate-scan wired everywhere; events from here are an honest sample
INGEST_STALE_MIN_AGE_H = 1     # transcripts younger than this may be a live session — not yet a miss
INGEST_STALE_MAX_AGE_D = 7     # older than this is history, not a live pipe problem
INGEST_MIN_BYTES = 10_000      # skip 2-turn husk transcripts
FALLBACK_STREAK = 3            # consecutive regex-only ingests before surfacing
DEGRADED_WINDOW_DAYS = 7       # a degraded event is an INCIDENT, not a standing state (P13)


def _same_bytes(a: Path, b: Path) -> bool:
    """Byte equality, where UNREADABLE IS DRIFT — never silently "in sync".

    THE ONE COMPARISON FOR EVERY DRIFT PREDICATE (P1, P4, P12, P14). Each of them globs a
    directory and then reads both sides, so either file can vanish or become unreadable
    between the glob and the read; an OSError there crashed the predicate. And the direction
    matters more than the crash: a drift check that cannot read a file must say DRIFT, not
    "match". Reporting a file it could not compare as in-sync is exactly the fail-open this
    watcher exists to catch, aimed at the watcher (#1).

    `bin/tessera-verify` (2026-08-09) returned this as a caveat on the log-read fix: the
    globbed *log* reads had been guarded and the globbed *byte* reads had not, so the fix
    that was written to be the class was still one row short of it.
    """
    try:
        return a.read_bytes() == b.read_bytes()
    except OSError:
        return False


def p1_hook_drift(root: Path) -> tuple[bool, str]:
    """Live SessionStart/etc. hooks missing from or differing in the install payload."""
    drift = []
    for s in sorted((root / ".claude" / "scripts").glob("*.sh")):
        t = root / "templates" / s.name
        if not t.is_file() or not _same_bytes(t, s):
            drift.append(s.name)
    if not drift:
        return False, "hooks in sync with templates/"
    return True, f"{len(drift)} live hook(s) missing/differ in templates/: {', '.join(drift)}"


# P2 (tess-verb count → `tess` umbrella) was RETIRED 2026-07-10. It fired on a
# proxy — verb count — that tracks no real friction: the tessera-* binaries are
# mostly hook-invoked, and an umbrella can't retire them (hooks call them by name),
# so it would add a layer, not consolidate. See observatory "Override mechanism".


def p3_restore_integrity(root: Path) -> tuple[bool, str]:
    """Is the restore payload DELIVERABLE? (ADR-0015. Was: count compaction events.)

    ── WHY THIS PREDICATE CHANGED SHAPE ──────────────────────────────────────────────────

    The old P3 asked "has compaction fired ≥3 times (non-manual)?" and never fired in 37 days.
    The premise was false. `mnemos-session-start.sh:30` gates on nothing but the checkpoint
    file existing, so the restore path runs identically on `startup`, `resume`, AND `compact`:

        checkpoints 541 · sessions ingested 121 · compaction_fired ~3

    The mechanism did not run 3 times, it ran ~121. P3 counted the rarest trigger — ~2% of
    invocations — and reported the mechanism as untested. Standing pattern #3, and worse than
    usual: a proxy normally CORRELATES with the pain; this one tracked a fiftieth of it.

    Not academic. The 2026-07-26 defect (checkpoint.py joined every GoalNode unbounded →
    11,119 chars → overflowed the SessionStart output limit → the harness delivered a 2KB
    preview instead of the checkpoint) was degrading ALL ~121 restores. Compaction found it
    by accident; a predicate scoped to the real event would have caught it in week one.

    ── WHAT THIS DOES AND DOES NOT CLAIM ─────────────────────────────────────────────────

    GREEN HERE MEANS "THE PAYLOAD SURVIVES DELIVERY". It does NOT mean restore works. That
    question is T2 in ADR-0015 (does the agent resume without re-deriving?), only the model
    can answer it, and its instrument IS NOT BUILT. Reading this predicate as a verdict on
    Mnemos would mint proxy #5 after P2 (verb count), old-P4 (project count), and sqlfluff
    (file existence). It is a REGRESSION GUARD on an observed failure, nothing more.

    Size is a direct measure, not a stand-in: checkpoint JSON tracks delivered bytes ~1:1
    (8,508 → 8,206 rendered; pre-fix ≈18,755 → 18,248, which SPILLED to a file and handed
    the model a 2KB preview). Budget sits clearly below the observed failure point.

    Compaction events are still TALLIED and reported — they remain the only evidence about
    T3 (frequency), which ADR-0015 demoted from blocking to informational. But `unknown` no
    longer fires on its own: the harness sends an empty PreCompact payload
    (`payload_probe {"len": 2, "keys": []}`), so it is a STANDING state, and a predicate that
    fires forever on an unfixable fact is noise. What DOES fire is a probe showing any keys —
    an EVENT meaning T3 just became answerable here (ADR-0015 re-evaluate trigger).
    """
    ck = root / ".mnemos" / "checkpoint-latest.json"
    log = root / ".mnemos" / "compaction-log.jsonl"

    # ── T3 tally: informational. Only the payload_probe can FIRE, because it is the one
    #    EVENT here; the rest is a standing state that would alarm forever. ──
    real = manual = unknown = 0
    probe_keys: list[str] = []
    if log.exists():
        for line in _read_lines(log):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if event.get("event") != "compaction_fired":
                continue
            probe = event.get("payload_probe") or {}
            if isinstance(probe, dict):
                probe_keys.extend(probe.get("keys") or [])
            trigger = event.get("trigger", "__absent__")
            if trigger == "manual":
                manual += 1
            elif trigger == "unknown":
                unknown += 1      # tagger ran, could not classify. Not evidence, not a test.
            else:
                real += 1         # "auto", or a pre-tagging entry with no key at all
    tally = (f"compaction {real} auto / {manual} manual / {unknown} unclassifiable "
             f"[T3, informational per ADR-0015]")

    # ── T1: is the payload deliverable at all? ──
    if not (root / ".mnemos").is_dir():
        return False, "no .mnemos/ — restore path not installed here"
    if not ck.exists():
        return True, (
            f"no .mnemos/checkpoint-latest.json — the restore path has NOTHING to deliver on "
            f"the next session start, and EVERY layer reads this one file. {tally}")

    # TWO try BLOCKS, ONE CONCERN EACH — arbiter (2026-08-09) called the single-try version
    # correct but fragile, and it was right on both counts. `size` was bound inside the same
    # try as the parse and then referenced from the `except ValueError` arm; that works only
    # because `stat()` precedes `read_text()` in the same block, which is invisible to the
    # next reader. Reorder those two lines and the error path raises UnboundLocalError —
    # inside a handler, i.e. in the one place nothing else would catch it.
    try:
        size = ck.stat().st_size
        raw = ck.read_text()
    except OSError as exc:
        # NOT the globbed-log case, and so NOT quiet: a checkpoint that exists and cannot be
        # read is precisely an UNDELIVERABLE payload, which is what T1 asks about. Reporting
        # it is the answer; crashing (the old behaviour, via evaluate()) buries it under a
        # ⚠ that says nothing about the restore path.
        return True, (
            f"checkpoint-latest.json exists but cannot be read ({type(exc).__name__}) — the "
            f"restore path has nothing deliverable on the next session start. {tally}")
    try:
        data = json.loads(raw)
    except ValueError:
        return True, (
            f"checkpoint-latest.json is not valid JSON ({size:,}b) — `mnemos resume` cannot "
            f"render it, so every session start restores nothing. {tally}")

    missing = [f for f in RESTORE_REQUIRED_FIELDS if f not in data]
    if missing:
        return True, (
            f"checkpoint is missing {', '.join(missing)} — the renderer reads these fields, so "
            f"those sections silently vanish from every restore. {tally}")

    if size > RESTORE_BUDGET_BYTES:
        return True, (
            f"checkpoint-latest.json is {size:,}b, over the {RESTORE_BUDGET_BYTES:,}b delivery "
            f"budget. Checkpoint bytes track delivered bytes ~1:1, and ≈18,755b was observed to "
            f"SPILL: the harness wrote the block to a file and handed the model a 2KB preview, "
            f"so Constraints/Progress/Files never arrived. This degrades EVERY session start, "
            f"not just compaction. Check the goal field first — goals are never-evict and one "
            f"is minted per ingested session. {tally}")

    if probe_keys:
        return True, (
            f"PreCompact payload_probe now reports keys {sorted(set(probe_keys))} — the harness "
            f"has started sending a payload, so T3 (compaction frequency) may be answerable "
            f"HERE for the first time. Re-read ADR-0015's re-evaluate triggers. {tally}")

    return False, (
        f"restore payload deliverable: {size:,}b / {RESTORE_BUDGET_BYTES:,}b, required fields "
        f"present. NOT a verdict on restore WORKING — that is T2, and its instrument is "
        f"unbuilt (ADR-0015). {tally}")


def p4_downstream(root: Path) -> tuple[bool, str]:
    """F-003 hook drift — measured in BYTES, not in project count.

    This predicate used to be `len(downstream_projects) >= 5`. Project count is a *proxy* for
    drift risk, and on 2026-07-21 the proxy broke visibly: adopting settempo (hook_distro
    `global`, zero local copies) tripped the threshold while adding exactly zero drift surface,
    and the fired message could not name a single stale file. Meanwhile three genuinely stale
    copies of mnemos-pre-compact.sh had been sitting in the frozen projects — the real F-003,
    which the count-based check never saw and never would.

    The observatory says it plainly (F-003 entry): *"A drift check that doesn't compare bytes
    isn't a drift check."* `bin/tessera-hooks status` compares declared-mode vs copy-count;
    doccheck's `hook-templates-match-live` already byte-diffs templates/ against the
    framework's own .claude/scripts/. This is that same check, one layer down: downstream local
    copies vs the global single source they shadow.

    Two failure modes, both real:
      drifted  — local copy differs from ~/.claude/templates/<name>; local always wins at
                 resolve time, so the downstream is silently running an older hook.
      orphaned — local copy with no global counterpart; nothing can ever sync it.

    Unlike the count predicate, this one can go GREEN: sync the copies and it stops firing.
    A predicate that cannot be resolved teaches you to ignore the watcher (see P9's docstring).

    ── READ WITH P14. THIS PREDICATE'S REFERENCE WAS ITSELF UNVALIDATED UNTIL 2026-07-26. ──
    Everything here is measured AGAINST `~/.claude/templates/`. On 2026-07-26 that tier was
    two days stale and missing a hook outright, and this predicate reported "all in sync"
    throughout — correctly, by its own definition, because downstream copies agreed with a
    reference that was wrong. **Uniform staleness reads as agreement.** P14 now validates the
    reference against the framework's live hooks. Green here means "downstream matches the
    global tier"; it has never meant "downstream is current", and only P14 can say that.
    """
    templates = Path.home() / ".claude" / "templates"
    drifted: list[str] = []
    orphaned: list[str] = []
    copies = 0
    for project in _downstream_projects(root):
        for local in sorted((project / ".claude" / "scripts").glob("mnemos-*.sh")):
            copies += 1
            global_copy = templates / local.name
            if not global_copy.is_file():
                orphaned.append(f"{project.name}/{local.name}")
            elif not _same_bytes(global_copy, local):
                drifted.append(f"{project.name}/{local.name}")

    n = len(_downstream_projects(root))
    if not drifted and not orphaned:
        return False, f"{copies} local hook copies across {n} downstream projects, all in sync"
    parts = []
    if drifted:
        parts.append(f"{len(drifted)} drifted: {', '.join(drifted)}")
    if orphaned:
        parts.append(f"{len(orphaned)} orphaned (no global source): {', '.join(orphaned)}")
    return True, (f"F-003 hook drift — {'; '.join(parts)}. Local copies shadow the global "
                  f"fallback, so these projects run stale hooks. Re-freeze with "
                  f"`tessera-hooks thaw && tessera-hooks freeze` in each, or thaw to global.")


def p5_skills(root: Path) -> tuple[bool, str]:
    """Skill count — eager-listing token cost the two-stage router would cut.

    `.claude/skills` IS GITIGNORED (a dogfood symlink built by ./install.sh), so it is
    ABSENT on every fresh clone. `iterdir()` raises FileNotFoundError there, which
    evaluate() correctly marks as a crash — and a crash exits 2, which
    tessera-watch-surface.sh reports as `runner-crashed`. So cloning this repo and running
    the watcher before install produced a ⚠ INCOMPLETE banner and a degraded event claiming
    the RUNNER was broken, when the truth is "the mirror is not built yet, and there is
    nothing to count". Same fresh-clone class as `referenced-paths-exist` (2026-08-09).
    `is_dir()` follows symlinks, so a dangling mirror link is quiet too — correctly: a link
    to nowhere has no skills behind it either.
    """
    skills = root / ".claude" / "skills"
    if not skills.is_dir():
        return False, "no .claude/skills mirror (unbuilt or absent) — nothing to route"
    n = sum(1 for d in skills.iterdir() if d.is_dir())
    return n >= SKILL_MIN, f"{n} skills (≥{SKILL_MIN} → two-stage hierarchical routing)"


def p6_escalations(root: Path) -> tuple[bool, str]:
    """Open escalation packets — an agent stopped, blocked, and needs a human decision.

    Surfacing rides the watcher rather than a fourth SessionStart hook. If this stays
    fired for 3 runs, G-a fires too — and that is correct, not noise: an escalation
    ignored for three sessions is a real finding about the human, not a bad predicate.
    Contract: docs/contracts/escalation.md.
    """
    directory = root / ".tessera" / "escalations"
    if not directory.is_dir():
        return False, "0 open escalations"
    open_count = 0
    for path in directory.glob("*.json"):
        try:
            packet = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            open_count += 1  # unreadable packet counts as needs-attention, never dropped
            continue
        status = packet.get("status")
        if status is not None and not isinstance(status, str):
            # A non-string status crashed `.split` — and the packet above already decided
            # that a packet it cannot understand counts as needs-attention rather than
            # being dropped. Same rule, one line further down: never silently, never fatally.
            open_count += 1
            continue
        if (status or "open").split(":", 1)[0].strip() == "open":
            open_count += 1
    return open_count > 0, f"{open_count} open escalations (→ `tessera-escalate list`)"


def p7_gate_labels(root: Path) -> tuple[bool, str]:
    """Unlabeled gate events recorded AFTER the gate-scan backstop went live.

    `should_fire` is the gate contract's ground-truth column and is null on every event
    ever recorded. Labeling was deferred 2026-07-11 (ADR-0005) for two reasons: the
    pre-backstop corpus is 61–91% truncated, and v1 escalation fires on hard blocks only,
    so no threshold depends on it yet. Neither reason survives a corpus that is both
    honest and large — so the revisit is a predicate, not a note. A note is what gets
    dropped on the floor; that is the drift this watcher exists to catch.

    Counts tessera + every downstream, since autonomy runs the downstreams.
    """
    total = 0
    for project in [root, *_downstream_projects(root)]:
        for log in (project / ".tessera" / "logs").glob("*.jsonl"):
            for line in _read_lines(log):
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if event.get("type") != "suggestion_gate":
                    continue
                if event.get("ts", "") < BACKSTOP_LIVE:
                    continue  # pre-backstop = truncated sample, not worth labeling
                if (event.get("data") or {}).get("should_fire") is None:
                    total += 1
    fired = total >= GATE_LABEL_MIN
    return fired, (f"{total} unlabeled post-backstop gates "
                   f"(≥{GATE_LABEL_MIN} → corpus is honest + big enough; label should_fire)")


def p8_doc_drift(root: Path) -> tuple[bool, str]:
    """Docs asserting things about this repo that are no longer true.

    Six doc-drift bugs were found 2026-07-09..11 — every one by Lorenzo asking "all docs
    updated?" on a hunch, and every one fixed without leaving a check behind. The human was
    the detector, and suspicion is a depleting resource: the better the framework gets, the
    less it gets asked, so drift accumulates fastest exactly when trust is highest. **Trust
    was the failure mode.** That is a #17 failure one level up — the *verification* rode on
    recall, not a channel. This is the channel. See scripts/doccheck.py.

    ── ABSENT AND BROKEN ARE NOT THE SAME ANSWER (arbiter, 2026-08-09) ───────────────────

    This used to be one `except Exception: return False, "doccheck unavailable (failing
    open)"`. Both a MISSING doccheck and one that raised inside `run()` returned
    fired=False — and `render()` only ever prints fired/snoozed/crashed results, so that
    message reached NOBODY. A doc-drift detector whose own failure mode is "docs honest,
    0 false claims" is standing pattern #2 aimed at the doc channel, and #12: the report
    was true about what it checked and silent about having checked nothing.

    So: an ImportError means doccheck is not installed here — a legitimate state, quiet.
    ANYTHING ELSE (a SyntaxError in doccheck, an exception inside run()) propagates, and
    evaluate() marks P8 `crashed` → ⚠ section, excluded from the fire-log, exit 2. Loud,
    and distinguishable from a clean green, which is the whole point.

    ── AND IT PUTS BACK WHAT IT BORROWS (2026-08-09) ─────────────────────────────────────

    This mutated two globals it does not own — `sys.path` and `doccheck.ROOT` — and restored
    neither. In production that is invisible: one predicate, one process, and ROOT already
    equals the repo. In any process that calls P8 twice with different roots it is not: the
    REAL doccheck module was left pointing at a deleted temp directory, and the next thing to
    import it inherited that. Measured — `doccheck.ROOT` went from the repo to
    `/var/folders/.../tmp1f0ys0wa` and stayed there.

    It surfaced as eight failures in `scripts/test_doccheck.py` that appear ONLY when the
    watch tests run first, and `pytest scripts/` collects alphabetically — doccheck before
    tessera-watch — so the suite was green over a live defect and stayed green by luck of
    the alphabet. That is the shape this repo keeps paying for: not a red test, a green one
    that owed its colour to something unrelated.
    """
    # THE PATH INSERT STAYS, and removing it was tried and REVERTED the same hour. `doccheck`
    # lazily imports siblings from `scripts/` DURING run() — prefix_meter, decision_surface,
    # report_settings — inside try/except. Pull the path out from under it and a check whose
    # import fails reports NO VIOLATIONS, which on a clean repo is byte-identical to passing.
    # Measured, and the measurement is the point: with and without the path, all 44 checks
    # returned the same results — because the repo is green, so "ran and found nothing" and
    # "could not run and said nothing" are indistinguishable from here. Tidying one sys.path
    # entry in a one-shot process is not worth buying that ambiguity. Idempotent instead.
    scripts = str(root / "scripts")
    if scripts not in sys.path:
        sys.path.insert(0, scripts)
    try:
        import doccheck
    except ImportError:
        return False, "no scripts/doccheck.py importable here — nothing to check"

    # A SENTINEL, because `None` meant two things. `getattr(m, "ROOT", None)` returns None
    # both when ROOT is absent and when it is present-and-None, and `if previous_root is not
    # None` skipped the restore for both — i.e. for the one case the restore exists to handle
    # (arbiter, 2026-08-09). REACHABLE IMPACT WAS NIL and that is stated rather than implied:
    # scripts/doccheck.py:37 defines `ROOT` at module level, so the real module always has it
    # and the restore always fired. Only a doccheck WITHOUT ROOT — a test fake — took the dead
    # branch. Fixed because a branch that reads as handling a case it silently drops is worse
    # than no branch.
    missing = object()
    previous_root = getattr(doccheck, "ROOT", missing)
    doccheck.ROOT = root

    # `run_detailed` is READ THROUGH getattr, not assumed. This file also runs against
    # DOWNSTREAM copies of doccheck.py, which are older and have `run()` only — assuming
    # the new API here would turn "your doccheck predates isolation" into an AttributeError
    # that reads as a crashed predicate. Ship both halves or neither (#5), and the other
    # half is on six other machines.
    detailed_fn = getattr(doccheck, "run_detailed", None)

    # THE WARN TIER IS READ THROUGH getattr FOR THE SAME REASON `run_detailed` IS (2026-08-17):
    # six downstream copies of doccheck.py predate it, and assuming the attribute would turn
    # "your doccheck is older" into a crashed predicate. A doccheck without the tier has no
    # warn-only checks, so an empty mapping is the correct reading, not a fallback.
    #
    # AND P8 MUST HONOUR IT, not merely tolerate it. Left alone, every warn-tier finding
    # would land in `violations` — session start goes red and the message calls it a false
    # doc claim, which is the wrong label (#12) and half-undoes the decision the tier
    # encodes. **P8 stays silent on warnings deliberately, and that is a narrowing worth
    # stating out loud rather than burying**: this predicate reports claims the repo can
    # VERIFY are false. The warn tier's channel is the pre-commit hook, which fires while
    # you are editing the page — not here, a session later.
    warn_only = set(getattr(doccheck, "WARN_ONLY", ()))
    try:
        if detailed_fn is not None:
            detailed = detailed_fn()
            crashed = sorted(n for n, (_f, e) in detailed.items() if e is not None)
            violations = [v for n, (vs, e) in detailed.items()
                          if e is None and n not in warn_only for v in vs]
        else:
            crashed = []
            violations = [v for n, vs in doccheck.run().items()
                          if n not in warn_only for v in vs]
    finally:
        if previous_root is missing:
            delattr(doccheck, "ROOT")          # it had none; leave it with none
        else:
            doccheck.ROOT = previous_root

    # A CRASHED CHECK FIRES, IT DOES NOT MARK P8 `crashed`. The distinction is which thing
    # broke: `crashed` means THIS PREDICATE could not run (doccheck missing, run() itself
    # exploding — still reached, see the ImportError arm and the test above). A check body
    # raising is something P8 successfully DETERMINED, and it is strictly more informative
    # than the old behaviour, which lost all 44 other results and could not name the
    # culprit. Before isolation this arm was unreachable: any check raising took run() down
    # and P8 reported `crashed` with no idea which one.
    if crashed:
        named = ", ".join(crashed[:3]) + (f" (+{len(crashed) - 3} more)" if len(crashed) > 3 else "")
        extra = f", plus {len(violations)} false doc claim(s)" if violations else ""
        return True, (f"{len(crashed)} doccheck CHECK(S) CRASHED — not a doc claim, a broken "
                      f"check: {named}{extra} → `python3 scripts/doccheck.py`")
    if not violations:
        return False, f"docs honest ({len(doccheck.CHECKS)} checks, 0 false claims)"
    head = violations[0] if len(violations) == 1 else f"{violations[0]} (+{len(violations)-1} more)"
    return True, f"{len(violations)} false doc claim(s) → `python3 scripts/doccheck.py`: {head}"


def p9_interpreter_drift(root: Path) -> tuple[bool, str]:
    """Bare `python3` cannot import the toolchain the hooks depend on.

    THIS IS THE F-001 DETECTOR, three months late. F-001 was: hooks invoked Mnemos via bare
    `python3` (Homebrew 3.14) while the package was installed for 3.13, so `auto_nodes` and
    every checkpoint write silently no-op'd for weeks. It was invisible — and it confounded
    the entire Mnemos kill/keep trial, because "the graph is empty" read as "unused" when it
    actually meant "unreachable". Nothing has ever watched for a recurrence.

    The condition is live RIGHT NOW: python@3.14 owns the `python3` name (Homebrew installed
    it as a dependency of awscli/httpie/mlx/ollama — `installed_on_request: False`, so it is
    NOT removable), while the whole toolchain lives in 3.13. Nothing is broken today, because
    mnemos's console-script shebang hard-pins 3.13 and the hooks probe `command -v mnemos`
    first. But every bare-`python3` script that grows a third-party import is a landmine, and
    it fails SILENTLY — the worst shape for an unsupervised run (ADR-0005).

    Deprecating 3.14 is impossible (five formulae need it). Migrating the toolchain INTO 3.14
    only resets the clock — Homebrew re-points `python3` whenever a dependent formula moves,
    so 3.15 will do this again. **A venv is the durable fix**, and docs/observatory.md said so
    long before this predicate existed. Decided 2026-07-11 (1a/2b): venv is right, deferred.

    So this fires every session until the venv lands. That is intentional, not noise — it is
    real, unresolved debt, and after 3 consecutive runs G-a escalates it. A prose note is what
    gets dropped on the floor; that is the entire lesson of this watcher.

    ── REWRITTEN 2026-07-12, when the venv landed. The old predicate was:

            subprocess.run(["python3", "-c", "import mnemos"])   # fires unless bare python3
                                                                 # can import the toolchain

    **That predicate could never go green after the fix it was demanding.** A venv does not
    change what bare `python3` resolves to; post-venv it *should* be unable to import mnemos,
    and that is correct, not broken. P9 would have fired forever, G-a would have escalated
    forever, and the only way out would have been to snooze our own detector — the inverse of
    the pre-commit lesson: **a detector that cannot go green teaches you to ignore the
    watcher.** It was asserting the wrong invariant all along; it just happened to be red for
    the right reason.

    The invariant that actually matters is the one F-001 violated:
    **does the interpreter the CONSUMER resolves actually have what it imports?**
    F-001 was never "bare python3 lacks mnemos" — it was "the hooks' interpreter lacked
    mnemos, and nobody checked *which* interpreter the hooks got."

    So: resolve `mnemos` the way a hook does (`command -v`), read the shebang it will actually
    execute under, and assert THAT interpreter can import the toolchain — and that its base is
    not owned by a package manager free to re-point it.
    """
    venv_python = root / ".venv" / "bin" / "python"
    expects_venv = (root / ".python-version").exists()

    mnemos_bin = shutil.which("mnemos")
    if not mnemos_bin:
        # "Nothing to drift from" was the old escape hatch, and it was a HOLE: with the venv
        # missing, ~/.local/bin/mnemos dangles, `which` returns None, and the detector went
        # SILENT on the worst possible state — the toolchain gone entirely, every hook failing
        # open into quiet. Found 2026-07-12 by parking .venv and watching P9 say nothing.
        # Absence is the loudest drift there is, not the absence of drift.
        if expects_venv:
            return True, ("mnemos is NOT resolvable, but this repo declares a toolchain "
                          "(.python-version) — every hook is failing open into silence. "
                          "Run ./install.sh")
        return False, "mnemos CLI absent and no toolchain declared (nothing to drift from)"

    if expects_venv and not venv_python.exists():
        return True, (f"no venv at {venv_python} but .python-version declares one — "
                      f"the toolchain is unbuilt. Run ./install.sh")

    try:
        shebang = Path(mnemos_bin).read_text().splitlines()[0]
    except (OSError, IndexError):
        return True, f"cannot read mnemos's shebang at {mnemos_bin} — interpreter unknowable"
    if not shebang.startswith("#!"):
        return False, "mnemos is not a script (packaged binary?) — nothing to drift"
    interp = shebang[2:].split()[0]

    # THE check: the interpreter the hooks will actually run under must have the toolchain.
    probe = subprocess.run([interp, "-c", "import mnemos"], capture_output=True, timeout=10)
    if probe.returncode != 0:
        return True, (f"mnemos resolves {interp}, which CANNOT import mnemos — F-001 exactly: "
                      f"the hooks' interpreter is missing the package. Run ./install.sh")

    # And its base must not be a package manager's, or brew re-points it and we are back here.
    base = subprocess.run([interp, "-c", "import sys; print(sys.base_prefix)"],
                          capture_output=True, text=True, timeout=10).stdout.strip()
    if "homebrew" in base.lower() or "Cellar" in base:
        return True, (f"toolchain interpreter is rooted in Homebrew ({base}) — brew re-points "
                      f"python whenever a dependent formula moves. That is how F-001 happened. "
                      f"Rebuild on a uv-managed base: rm -rf .venv && ./install.sh")

    # ── SECOND CONSUMER: icpg. Added 2026-07-26. ──────────────────────────────────────
    # P9's invariant is "does the interpreter the CONSUMER resolves have what it imports?" —
    # and mnemos was the only consumer ever checked. `mnemos-pre-edit.sh` ALSO shells out to
    # `icpg` for the intent/constraint/drift half of the documented "PreToolUse checks fatigue
    # and intent" feature, and `icpg` resolves through a NAME on a mutable PATH exactly as
    # mnemos did. If it breaks, that half silently vanishes, the hook reports nothing, and no
    # predicate mentioned icpg at all — so the feature would read as "this file has no
    # intents" rather than "the tool is gone". **That is F-001's confound verbatim: empty
    # would have meant unreachable, and we would have read it as unused.**
    #
    # Declare-then-check, mirroring `expects_venv`: only a project that USES icpg (it has a
    # reason.db) can be missing it. Silent elsewhere rather than noisy everywhere.
    if (root / ".icpg" / "reason.db").exists():
        icpg_bin = shutil.which("icpg") or str(root / ".venv" / "bin" / "icpg")
        if not Path(icpg_bin).exists():
            return True, ("this repo has .icpg/reason.db but `icpg` is NOT resolvable — the "
                          "intent/constraint half of mnemos-pre-edit is silently dead, and it "
                          "looks exactly like 'this file has no intents' (F-001's confound)")
        probe = subprocess.run([interp, "-c", "import icpg"], capture_output=True, timeout=10)
        if probe.returncode != 0:
            return True, (f"`icpg` resolves but {interp} CANNOT import icpg — the intent half "
                          f"of mnemos-pre-edit fails open into silence. Run ./install.sh")

    return False, f"toolchain interpreter is reachable and manager-independent ({interp}); icpg ok"


def g_a_consecutive(root: Path) -> tuple[bool, str]:
    """Graduation-a: a core predicate fired in ≥3 consecutive logged runs → needs snooze/ack.

    Closes the self-evaluation loop — the fire-log has a reader, so 'when to graduate
    to stateful machinery' is itself a fired predicate, not a prose note (#17). The
    detector is substrate; the remedy (actual snooze state) waits until this fires.
    """
    runs = _read_firelog(root)
    if len(runs) < GRADUATION_RUNS:
        return False, f"{len(runs)} logged runs (<{GRADUATION_RUNS} → not yet judgeable)"
    persistent = set.intersection(*(set(r) for r in runs[-GRADUATION_RUNS:]))
    # A currently-snoozed predicate is a remedy ALREADY APPLIED — G-a must not keep nagging
    # about it while the historical fire-log still shows it (the log is the tail, not now).
    snoozed = active_snooze_labels(root, datetime.now(timezone.utc))
    core = sorted(p for p in persistent if p.startswith("P") and p not in snoozed)
    if not core:
        return False, f"no core predicate fired {GRADUATION_RUNS} runs running"
    return True, f"{', '.join(core)} fired {GRADUATION_RUNS} consecutive runs → build remedy or add snooze"


def _read_firelog(root: Path) -> list[list[str]]:
    """Fired-label lists per prior run, chronological. The watcher reading its own history.

    READS `fired` AND IGNORES `crashed` ON PURPOSE. arbiter (2026-08-09) noted that a
    predicate crashing on one run drops out of G-a's consecutive-fire intersection, so a
    genuine fire on runs 1 and 3 with a crash on run 2 will not graduate. That is the
    CONSERVATIVE direction and it is the one to want: graduation is a claim that a predicate
    reliably fires, and a run where it could not produce a result is not evidence for that
    claim. Its sibling worry — that a persistently crashing predicate looks like it never
    fires — is real but belongs to P13/`degraded`, which reports the crash within a session.
    Coverage here is DISTRIBUTED; auditing it per-function is the error the degraded-event
    contract warns about (three wrong findings, 2026-07-26).
    """
    log = root / ".tessera" / "logs" / "watch.jsonl"
    if not log.exists():
        return []
    runs = []
    for line in _read_lines(log):
        try:
            runs.append(json.loads(line).get("fired", []))
        except (ValueError, AttributeError):
            pass
    return runs


def _read_lines(path: Path) -> list[str]:
    """Lines of a log file, or [] if it cannot be read. THE ONE READER FOR GLOBBED LOGS.

    Every caller here found its path with `glob()` and reads it a moment later, so the file
    can vanish between the two (a rotated or pruned log), be a dangling symlink, or be
    unreadable — and an OSError inside a predicate lands it in evaluate()'s crash bucket,
    which prints ⚠ INCOMPLETE and exits 2. A transient log read must not be able to
    manufacture a crash report about the observatory.

    arbiter (2026-08-09) reported this against P7 and stated P7 was the last one left. It
    was not: P3's compaction log, P13's degraded scan and `_read_firelog` all had the same
    unguarded read, and P13 in particular LOOKS guarded — its `try` covers `stat()` only,
    and `errors="replace"` guards DECODING, not OSError. Fixing the reported row would have
    left three (#11). P16's inline guard is folded in here too, so there is one definition
    rather than two: skipping UNDERCOUNTS, which can only ever hold a predicate quieter —
    it can never manufacture a bar-met or a false fire.
    """
    try:
        return path.read_text(errors="replace").splitlines()
    except OSError:
        return []


def _downstream_projects(root: Path) -> list[Path]:
    projects = (p.parent.parent for p in root.parent.glob("*/.tessera/project.yml"))
    return [p for p in projects if p.resolve() != root.resolve()]


# ── Snooze: an auditable ack that quiets a predicate for a bounded window. ──────────────
# EARNED by G-a (graduation-a): the observatory's "NO snooze until a graduation predicate
# earns it" is satisfied once G-a fires. A snooze is a DECISION, so it is TRACKED (committed
# .tessera/watch-snooze.json), carries a required --reason, and EXPIRES — a snoozed predicate
# resurfaces on the `until` date so nothing is buried forever. Snoozed-but-fired counts as
# NOT firing: quiet exit, and G-a stops counting it (the fire-log excludes it).
SNOOZE_PATH = ".tessera/watch-snooze.json"


def _load_snoozes(root: Path) -> dict:
    p = root / SNOOZE_PATH
    if not p.exists():
        return {}
    try:
        return json.loads(p.read_text())
    except ValueError:
        return {}


def _write_snoozes(root: Path, snoozes: dict) -> None:
    p = root / SNOOZE_PATH
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(snoozes, indent=2, sort_keys=True) + "\n")


def active_snooze_labels(root: Path, now: datetime) -> set:
    """Predicate labels with an unexpired snooze (now < until)."""
    active = set()
    for label, s in _load_snoozes(root).items():
        try:
            if now < datetime.fromisoformat(s["until"]):
                active.add(label)
        except (KeyError, ValueError, TypeError):
            continue
    return active


def _transcripts_dir(root: Path) -> Path:
    """Claude Code's per-project transcript dir for this repo (path-slug)."""
    slug = str(root.resolve()).replace("/", "-")
    return Path.home() / ".claude" / "projects" / slug


def p11_ingest_pipe(root: Path, transcripts_dir: Path | None = None) -> tuple[bool, str]:
    """The Stop-hook ingest pipe is silently dead or silently degraded.

    Two failure shapes, both observed or near-missed on 2026-07-20 (spec 16):
    (a) DEAD — ingest crashes before writing anything, so recent transcripts
        have no claude_sessions row at all. A status column cannot see this
        (nothing was written); only transcript-vs-store diffing can. This is
        exactly how a make_detector() import error killed every hook ingest
        from 07-17 to 07-20 while hand-runs kept working (F-001's cousin).
    (b) DEGRADED — ingest runs but the classifier silently falls back to
        regex-only every time (classifier_status trace, written per ingest).
    Age window: <1h may be a live session (not yet a miss); >7d is history.
    """
    tdir = transcripts_dir or _transcripts_dir(root)
    db = root / ".mnemos" / "mnemo.db"
    if not tdir.is_dir() or not db.exists():
        return False, "no transcripts dir or no mnemos db"
    now = datetime.now(timezone.utc).timestamp()
    # ONE stat per file, inside a guard. It was three, unguarded: a transcript that vanishes
    # or turns unreadable between the glob and any of them crashed P11, and a file rotated
    # between the size stat and the mtime stat could be judged on two different snapshots.
    # Skipping an unstattable file UNDERCOUNTS, which can only hold P11 quieter — it can
    # never manufacture a "pipe is DEAD" alarm (verifier caveat, 2026-08-09).
    recent = []
    for p in tdir.glob("*.jsonl"):
        try:
            st = p.stat()
        except OSError:
            continue
        if st.st_size >= INGEST_MIN_BYTES and (
                INGEST_STALE_MIN_AGE_H * 3600 <= now - st.st_mtime
                <= INGEST_STALE_MAX_AGE_D * 86400):
            recent.append(p)
    try:
        conn = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        try:
            known = {r[0] for r in conn.execute("SELECT id FROM claude_sessions")}
            cols = {r[1] for r in conn.execute("PRAGMA table_info(claude_sessions)")}
            streak = 0
            if "classifier_status" in cols:
                statuses = [r[0] for r in conn.execute(
                    "SELECT classifier_status FROM claude_sessions "
                    "WHERE classifier_status IS NOT NULL "
                    "ORDER BY last_ingested_at DESC LIMIT ?", (FALLBACK_STREAK,))]
                # budget-exhausted = classifier partially ran (a bulk sweep
                # sharing one wall-clock budget) — degraded is regex-only/
                # disabled, the shapes where it never judged a single turn.
                dead = ("regex-only:", "disabled-mid:")
                if len(statuses) == FALLBACK_STREAK and \
                        all(s.startswith(dead) for s in statuses):
                    streak = FALLBACK_STREAK
        finally:
            conn.close()
    except sqlite3.Error:
        return False, "no claude_sessions table"
    missing = sorted(p.stem[:8] for p in recent if p.stem not in known)
    if missing:
        return True, (
            f"{len(missing)} recent transcript(s) never ingested "
            f"({', '.join(missing[:5])}{'…' if len(missing) > 5 else ''}) — "
            f"Stop-hook ingest pipe looks DEAD; run it by hand and read stderr")
    if streak:
        return True, (
            f"last {streak} ingests all fell back to regex-only "
            f"(classifier_status) — classifier pipe silently degraded")
    return False, f"{len(recent)} recent transcript(s), all ingested; no fallback streak"


def p12_skill_registry_drift(root: Path, global_dir: Path | None = None) -> tuple[bool, str]:
    """Repo skills/ and the global mirror have diverged (ADR-0010).

    Repo is truth, ~/.claude/skills is a managed mirror written only by
    bin/tessera-sync-skills. Any difference — extra/missing skill dirs or
    changed file content — means either an unsynced repo edit (run the sync)
    or a foreign writer to global (find it BEFORE re-syncing over it; see
    ADR-0010 re-evaluate triggers). Same shape as P1 hook-drift. The last
    unwatched divergence lasted three weeks (6 stale skills, 10 zombies).

    ── IT COMPARES BYTES NOW. IT DID NOT BEFORE. (2026-08-09) ─────────────────────────────
    This read `filecmp.dircmp(...).diff_files`, whose default is a SHALLOW compare: two
    files with the same size and the same mtime are declared identical WITHOUT reading
    either. Measured — 4 bytes vs 4 different bytes, mtimes equalised, and this predicate
    returned "repo skills/ == global mirror". P1, P4 and P14 all `read_bytes()`; only the
    skill mirror trusted a stat signature, and `tessera-sync-skills` is `rsync -a`, which
    PRESERVES mtime, so the two sides routinely share one. F-003's lesson is quoted verbatim
    in p4_downstream's own docstring one screen up: *"A drift check that doesn't compare
    bytes isn't a drift check."* This was one. `dircmp` still supplies the tree walk and the
    left/right-only sets — only the sameness verdict is taken back.

    (`dircmp(..., shallow=False)` exists only on Python 3.13+; this file must run on
    whatever `python3` resolves to, including macOS's 3.9. Hence the explicit compare.)
    """
    import filecmp
    src = root / "skills"
    dst = global_dir if global_dir is not None else Path.home() / ".claude" / "skills"
    if not src.is_dir() or not dst.is_dir():
        return False, "repo skills/ or global mirror missing"

    drift: list[str] = []

    def walk(cmp: filecmp.dircmp, rel: str) -> None:
        for n in cmp.left_only:
            drift.append(f"repo-only: {rel}{n}")
        for n in cmp.right_only:
            drift.append(f"global-only: {rel}{n}")
        for n in cmp.common_files:
            if not _same_bytes(Path(cmp.left) / n, Path(cmp.right) / n):
                drift.append(f"differs: {rel}{n}")
        for n, sub in cmp.subdirs.items():
            walk(sub, f"{rel}{n}/")

    walk(filecmp.dircmp(src, dst), "")
    if drift:
        return True, (f"{len(drift)} difference(s) repo skills/ vs global mirror "
                      f"({', '.join(drift[:4])}{'…' if len(drift) > 4 else ''}) — "
                      f"run bin/tessera-sync-skills (or find the foreign writer first)")
    return False, "repo skills/ == global mirror"


def p13_degraded(root: Path, now: datetime | None = None) -> tuple[bool, str]:
    """A component reported that it COULD NOT DO ITS JOB (spec 11).

    The exit condition of spec 11 is binary: break a component on purpose and Tessera
    says so within one session, without a human asking. `tessera-degraded` writes the
    event; this is the half that makes it reach a human, via the SessionStart surface.

    WINDOWED ON PURPOSE, and the reason is a lesson paid for elsewhere in this repo:
    iCPG's drift backlog reached 700 undisposed rows because nothing could ever leave
    the open set, and a counter that only increments is indistinguishable from a broken
    detector. A `degraded` event is an INCIDENT, not a standing state — "the guard was
    missing last Tuesday" is history; "the guard is missing now" is the alarm. So this
    asks about the recent past only, and needs no disposition verb to stay honest.

    `ts` may legitimately be empty: tessera-degraded runs with shell builtins only and
    `date` is not guaranteed (chaos probe 5 hides it). Those fall back to the log file's
    mtime rather than being dropped — losing the loudest events to a missing clock would
    be this spec's own failure mode.
    """
    now = now or datetime.now(timezone.utc)
    logs = root / ".tessera" / "logs"
    if not logs.is_dir():
        return False, "no .tessera/logs/"

    recent: list[str] = []
    for log in logs.glob("*.jsonl"):
        if log.name == "watch.jsonl":
            continue
        try:
            mtime = datetime.fromtimestamp(log.stat().st_mtime, timezone.utc)
        except OSError:
            continue
        for line in _read_lines(log):
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if event.get("type") != "degraded":
                continue
            stamp = event.get("ts") or ""
            try:
                when = datetime.fromisoformat(stamp.replace("Z", "+00:00"))
            except (ValueError, AttributeError):
                when = mtime          # blank/unparseable/non-string ts — see docstring
            if when.tzinfo is None:
                # A NAIVE stamp PARSES and then explodes on the subtraction below
                # ("can't subtract offset-naive and offset-aware datetimes"), so the
                # except above never sees it. `tessera-degraded` always writes Z — but
                # this predicate scans EVERY .jsonl in .tessera/logs, written by five
                # producers (gate, spend, override, restore, degraded) and by whatever a
                # downstream adds next. One producer omitting an offset would crash the
                # spec-11 channel: the one predicate whose job is to report that something
                # else broke. Treated as UTC, which is what every current writer means.
                when = when.replace(tzinfo=timezone.utc)
            if (now - when).days <= DEGRADED_WINDOW_DAYS:
                data = event.get("data") or {}
                recent.append(f"{data.get('component', '?')}/{data.get('reason', '?')}")

    if not recent:
        return False, f"no degraded events in {DEGRADED_WINDOW_DAYS}d"
    unique = sorted(set(recent))
    return True, (f"{len(recent)} degraded event(s) in {DEGRADED_WINDOW_DAYS}d "
                  f"({', '.join(unique[:4])}{'…' if len(unique) > 4 else ''}) — a component "
                  f"could not do its job; see .tessera/logs/ and docs/contracts/degraded-event.md")


def _resolve_label(query: str) -> str | None:
    """Unique predicate whose label contains `query` (case-insensitive), or None."""
    matches = [label for label in PREDICATES if query.lower() in label.lower()]
    return matches[0] if len(matches) == 1 else None


def _max_spend_fires(root: Path) -> int:
    """Read the cap FROM the backstop rather than restating it here.

    A mirrored constant is a second definition, and this repo has paid for those: doccheck's
    reporting check imports the fixer's predicate instead of copying its regex, for exactly
    this reason. If someone tunes MAX_FIRES, this predicate must move with it.
    """
    src = root / "scripts" / "spend" / "backstop.py"
    try:
        for line in src.read_text().splitlines():
            if line.startswith("MAX_FIRES"):
                return int(line.split("=", 1)[1].strip())
    except (OSError, ValueError):
        pass
    return 3


# T2's read-trigger (ADR-0015, observatory "T2 downstream"). A DATE, not a derived anchor:
# the 30-day arm is load-bearing precisely when there are zero receipts, so anchoring it on
# the receipts themselves would make it unreachable in the only state that needs it.
T2_SHIPPED = datetime(2026, 7, 29, tzinfo=timezone.utc)
T2_RECEIPT_BAR = 10             # total downstream receipts...
T2_PROJECT_BAR = 3              # ...across this many distinct projects
T2_PATIENCE_DAYS = 30


def p16_t2_receipts(root: Path, now: datetime | None = None) -> tuple[bool, str]:
    """Is there enough downstream T2 data to be worth READING yet?

    ── THIS PREDICATE GUARDS AGAINST READING TOO EARLY, WHICH IS UNUSUAL, AND DELIBERATE ──

    The T2 instrument shipped downstream on 2026-07-29 having produced **zero** receipts in
    the fleet's entire history: `restore_offered` was 0 across 34 sessions in 6 projects, 26
    of them substantive, because `scripts/restore/` was never scaffolded. It is now installed
    and empty *by construction*.

    An empty new instrument is the exact state in which this repo has twice formed a verdict
    it had no business forming — P3 counted 3 compactions and called Mnemos untested for 37
    days; `usage` was re-scoped three times and decided zero. So the observatory's stopping
    rule says: not next session, not the one after; >=10 receipts across >=3 distinct
    projects. This is that rule, moved out of prose a human has to re-read and into the
    harness — because "an entry nobody re-reads" is the failure mode that entry documents.

    THREE projects, not two: two cannot separate a venue effect from one project's bad
    checkpoint.

    TESSERA'S OWN RECEIPTS DO NOT COUNT, and that is the whole point of shipping downstream.
    `active.md` records why: *"orientation came from THIS FILE and the standing-patterns
    block, not from the checkpoint… a downstream app has no such file."* Free here —
    `_downstream_projects()` already excludes root.

    ── WHAT IT MUST NEVER DO ─────────────────────────────────────────────────────────────
    It counts receipts. It does NOT read them: no sufficient/insufficient tally, no scoring,
    no band. The moment a predicate summarises the verdict it becomes a proxy for the
    judgement, and this repo has retired three proxy predicates already (#3). "Is it time to
    read" is mechanical; "what do they say" is a human's job and stays one.

    Both fire messages are green lights, not alarms — and the 30-day one is worded with care,
    because a thin-data message that reads like failure invites exactly the substitution the
    stopping rule forbids: treating what little arrived as an answer about Mnemos.
    """
    now = now or datetime.now(timezone.utc)
    # Keyed by RESOLVED PATH, displayed by name. `_downstream_projects` globs one parent
    # non-recursively today, so names are unique by construction and this cannot collide —
    # but the project count is half the bar, and a collision would MERGE two projects into
    # one counter, undercounting distinct projects and holding the predicate quiet. A
    # predicate that fails by staying silent is the failure class this whole entry is about,
    # so it does not get to depend on a property of a different function (arbiter, 2026-07-29).
    per_project: dict[Path, int] = {}
    for project in _downstream_projects(root):
        logs = project / ".tessera" / "logs"
        if not logs.is_dir():
            continue
        key = project.resolve()
        for log in logs.glob("*.jsonl"):
            # Guarded read — see `_read_lines`. This site had the ONLY inline guard, added
            # when arbiter found the race here (2026-07-29); the guard is now shared, because
            # a second definition of "how to read a log safely" is how three siblings ended up
            # without one.
            for line in _read_lines(log):
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if event.get("type") == "restore_receipt":
                    per_project[key] = per_project.get(key, 0) + 1

    total = sum(per_project.values())
    breakdown = ", ".join(f"{p.name} {n}" for p, n in
                          sorted(per_project.items(), key=lambda kv: kv[0].name)) or "none"

    if total >= T2_RECEIPT_BAR and len(per_project) >= T2_PROJECT_BAR:
        return True, (f"T2 BAR MET — {total} downstream restore receipts across "
                      f"{len(per_project)} projects ({breakdown}). This is a GREEN LIGHT, not "
                      f"an alarm: the stopping rule in docs/observatory.md -> 'T2 downstream' "
                      f"is satisfied, so the read is now legitimate. Read the four signals "
                      f"there first — only ONE of them is evidence about Mnemos.")

    # WHICH dimension is short, not "under the bar". The bars are AND-ed deliberately (see
    # THREE projects, above), so one can be met while the other is not — and then this arm
    # said "under the 10/3 bar" while quoting a receipt count ABOVE 10, contradicting itself.
    # arbiter flagged it 2026-08-07 and correctly did not call it a logic bug: the AND is
    # intended, the SENTENCE was wrong. Naming the short dimension also makes the message
    # actionable — "get a third project reporting" is a different job from "wait for volume".
    # No `or "…"` fallback: the AND-ed early return above has already fired if BOTH bars are
    # met, so at least one branch here always appends and the join is never empty. A dead
    # fallback reads as a documented state that cannot occur (arbiter, 2026-08-09).
    short = []
    if total < T2_RECEIPT_BAR:
        short.append(f"receipts {total}/{T2_RECEIPT_BAR}")
    if len(per_project) < T2_PROJECT_BAR:
        short.append(f"projects {len(per_project)}/{T2_PROJECT_BAR}")
    shortfall = " and ".join(short)

    elapsed = (now - T2_SHIPPED).days
    if elapsed >= T2_PATIENCE_DAYS:
        return True, (f"T2 has run {elapsed} days and collected {total} receipt(s) across "
                      f"{len(per_project)} project(s) ({breakdown}); still short on "
                      f"{shortfall}. THE FINDING IS THE RATE, NOT "
                      f"MNEMOS — read signal 1 (is the ask landing?) in docs/observatory.md. "
                      f"Do NOT read the thin data as a verdict; that substitution is what the "
                      f"stopping rule exists to prevent.")

    return False, (f"T2 accruing: {total}/{T2_RECEIPT_BAR} receipts across "
                   f"{len(per_project)}/{T2_PROJECT_BAR} projects ({breakdown}), day "
                   f"{elapsed}/{T2_PATIENCE_DAYS} — too early to read, by design")


def p15_spend_backstop_suppressed(root: Path) -> tuple[bool, str]:
    """Can the spend backstop still fire, or has its own cap silenced it?

    ── WHY THIS EXISTS ───────────────────────────────────────────────────────────────────

    `.tessera/.spend-backstop-fires` was a single global integer that nothing ever reset, and
    `backstop.main()` returns 0 once it exceeds `MAX_FIRES` (3). Found on 2026-07-27 holding
    **47**: the backstop that catches a vanished spend denial had been silently dead, and its
    `rc=0` is indistinguishable from "nothing to report". The cap was written as loop-safety
    for ONE session; against a monotonic counter it outlived every session it protected.

    Fixed by keying the counter per session — but a fix is not a signal. This is the paired
    detector, because the failure it guards is *the guard being off*, which by construction
    announces nothing (standing patterns #1 and #2).

    Fires on two states, both meaning "suppressed or heading there":
      · a LEGACY scalar file — pre-fix state, or a downstream that has not taken the fix
      · the cap reached in 2+ of the recorded sessions — either denials are chronically
        undispositioned, or the backstop is wedging and about to be ripped out

    Deliberately NOT firing on one capped session: that is the loop-safety doing its job.
    """
    path = root / ".tessera" / ".spend-backstop-fires"
    if not path.exists():
        return False, "spend backstop has never capped — it can fire"

    raw = path.read_text().strip()
    # AN EMPTY FILE IS NOT A LEGACY COUNTER (arbiter, 2026-08-09). `touch`, a truncated
    # write, or a half-finished `write_text` leaves this empty — and empty fell through to
    # the non-dict branch below, which announced "holds a legacy global counter ('')" and
    # told the operator a suppression had occurred. Measured against the mechanism it
    # reports on: `backstop._read_fires()` returns `{}` for an unreadable or empty file
    # ON PURPOSE, so the backstop is fully ENABLED in this state. The alarm was not just
    # mis-worded, it was inverted — a false report of a dead guard from the predicate whose
    # only job is to say whether the guard is dead.
    if not raw:
        return False, "spend backstop counter file is empty — no fires recorded, it can fire"
    try:
        fires = json.loads(raw)
    except ValueError:
        fires = None
    # A bare `47` is VALID json, so the legacy shape arrives as an int, not a parse error.
    # Both non-dict shapes mean the same thing and get the same message.
    if not isinstance(fires, dict):
        # THE SHAPE IS THE FINDING, AND THE WORDING NOW SAYS SO. This asserted that a
        # suppression HAD occurred — true of the 47 it was written for, false of `0` or of
        # `not json`, which are the same pre-fix shape with nothing suppressed yet. The
        # verifier flagged it (2026-08-09) while confirming the empty-file fix: a message
        # that over-claims turns a correct alarm into a false report, which is what P15's
        # own subject taught (#12).
        return True, (f".spend-backstop-fires holds a legacy global counter ({raw[:20]!r}) "
                      f"instead of the per-session map. In that shape a value over MAX_FIRES "
                      f"silences the spend backstop in EVERY session, permanently — it was "
                      f"found at 47. Delete the file to take the per-session fix; it is "
                      f"untracked runtime state and rebuilds itself.")

    cap = _max_spend_fires(root)
    capped = [s for s, n in fires.items() if isinstance(n, int) and n > cap]
    if len(capped) >= 2:
        return True, (f"the spend backstop hit its cap in {len(capped)} sessions "
                      f"({', '.join(s[:8] for s in capped[:3])}…) — either spend denials are "
                      f"chronically undispositioned, or the backstop is wedging sessions")
    return False, f"spend backstop live ({len(fires)} session(s) tracked, {len(capped)} capped)"


def p14_global_tier_drift(root: Path) -> tuple[bool, str]:
    """Does the GLOBAL fallback tier match this repo's live hooks? (ADR-0004 tier 3.)

    ── THE GAP THIS CLOSES, AND WHY P4 COULD NOT SEE IT ──────────────────────────────────

    Three tiers carry the same hooks:

        .claude/scripts/      framework truth (tessera is hook_distro `source`)
        templates/            the install payload           <- P1 + doccheck guard this edge
        ~/.claude/templates/  what downstream ACTUALLY RUNS <- nothing guarded this edge

    On 2026-07-26 the global tier held **7 stale hooks and was missing
    `tessera-decision-surface.sh` entirely**. All three PreToolUse hooks had ZERO
    `additionalContext`, so the 07-24 channel fix — the one that made Layer 3, the fatigue
    injection, and the decision surface reach the model at all — had never propagated to a
    single downstream project. `./install.sh` is the only propagation and it is manual.

    **P4 reported "all in sync" throughout.** It compares downstream LOCAL copies against
    `~/.claude/templates/`, i.e. it validates against this tier as its reference — while
    nothing validated the reference. Uniform staleness reads as agreement. That is standing
    pattern #1 aimed at a checker: the thing that would tell you the fleet is behind was
    measuring against the thing that was behind. P4 also globs `mnemos-*.sh` only, so an
    entirely missing `tessera-*.sh` was invisible to it twice over.

    Guarded by `.bootstrap-dir`: only THIS repo may assert on the global tier, since another
    checkout may legitimately own it. Silent elsewhere rather than wrong elsewhere.
    """
    tier3 = Path.home() / ".claude" / "templates"
    marker = Path.home() / ".claude" / ".bootstrap-dir"

    if not tier3.is_dir():
        return False, "no ~/.claude/templates — global fallback tier not installed"
    owner = marker.read_text().strip() if marker.is_file() else ""
    # SAME DIRECTORY, NOT SAME STRING — and this silenced P14 on 2026-08-09 in front of me.
    # `install.sh` writes `$REPO` as `pwd` gives it, and macOS's filesystem is CASE-INSENSITIVE:
    # a run from `/Users/…/claude/tessera` wrote that spelling while `ROOT` resolves to
    # `/Users/…/Claude/tessera`. Both are the same directory. The string compare said "owned by
    # another repo", P14 returned quiet, and quiet is INDISTINGUISHABLE IN THE RENDER from "the
    # global tier is in sync" — the predicate whose entire subject is that uniform staleness reads
    # as agreement, silenced by exactly that shape one level up.
    #
    # `resolve()` is NOT enough: it resolves symlinks, not case (measured — the two spellings
    # compare unequal after resolve, and equal under samefile, which tests st_dev/st_ino). This is
    # install.sh's own lesson, which after two rounds of arbiter findings landed on `pwd -P`
    # physical equality for the dogfood symlinks: compare the THING, never its spelling.
    try:
        owned_by_us = bool(owner) and Path(owner).samefile(root)
    except OSError:
        owned_by_us = False        # a recorded owner that no longer exists is not this repo
    if not owned_by_us:
        return False, (f"global tier is owned by {owner or '<unknown>'}, not this repo — "
                       f"not asserting on it")

    live = sorted((root / ".claude" / "scripts").glob("*"))
    missing, stale = [], []
    for f in live:
        if not f.is_file():
            continue
        counterpart = tier3 / f.name
        if not counterpart.is_file():
            missing.append(f.name)
        elif not _same_bytes(counterpart, f):
            stale.append(f.name)

    if not missing and not stale:
        return False, f"global tier matches all {len(live)} live hooks (byte-identical)"

    parts = []
    if missing:
        parts.append(f"MISSING from the global tier: {', '.join(missing)}")
    if stale:
        parts.append(f"STALE in the global tier: {', '.join(stale)}")
    return True, (
        f"{'; '.join(parts)}. Every downstream on the default `hook_distro: global` runs "
        f"THIS tier, so the fix exists and has shipped to nobody. Run `./install.sh`. "
        f"NOTE: P4 will read 'all in sync' while this is red — it measures downstream copies "
        f"against this tier, so uniform staleness looks like agreement.")

PREDICATES = {
    "P1 hook-drift": p1_hook_drift,
    "P3 mnemos-restore-integrity": p3_restore_integrity,
    "P4 downstream-drift": p4_downstream,
    "P5 skill-routing": p5_skills,
    "P6 escalations": p6_escalations,
    "P7 gate-labels": p7_gate_labels,
    "P8 doc-drift": p8_doc_drift,
    "P9 interpreter-drift": p9_interpreter_drift,
    "P11 ingest-pipe": p11_ingest_pipe,
    "P12 skill-registry-drift": p12_skill_registry_drift,
    "P13 degraded": p13_degraded,
    "P14 global-tier-drift": p14_global_tier_drift,
    "P15 spend-backstop-suppressed": p15_spend_backstop_suppressed,
    "P16 t2-receipts": p16_t2_receipts,
    "G-a graduation:snooze": g_a_consecutive,
}


def evaluate(root: Path) -> list[dict]:
    """Run every predicate; one result dict each. Mark any with an active snooze.

    ISOLATED PER PREDICATE (2026-08-09, arbiter). This loop had no `try`, so one predicate
    raising took down EVERY predicate's run — P16's unguarded `log.read_text()` was the
    reported instance, but the loop is the defect: six other reads here are equally
    unguarded, and fixing only P16 would be fixing the row rather than the pattern (#11).

    **The reported mitigation did not hold, and measuring it is what made this urgent.**
    active.md said a crash exits non-zero so `tessera-watch-surface.sh` emits
    `degraded --reason runner-crashed` — "loud, not silent". Measured: an unhandled Python
    exception exits **1**, and the surfacer reads 1 as *something fired*. A session got
    `=== OBSERVATORY WATCH ===` followed by nothing, and no degraded event. A header
    advertising fired triggers over an empty body is standing pattern #12's exact shape, and
    the claim that it failed loud is what lowered the item's priority.

    So a crash must stay DISTINGUISHABLE, not merely survivable: it is marked `crashed`,
    rendered, excluded from the fire-log, and turned into exit **2** by `main()`, which is
    the code the surfacer already treats as a crash. That makes the documented mitigation
    true for the first time.
    """
    snoozed = active_snooze_labels(root, datetime.now(timezone.utc))
    snoozes = _load_snoozes(root)
    out = []
    for label, pred in PREDICATES.items():
        crashed = False
        try:
            fired, detail = pred(root)
        except Exception as exc:                                  # noqa: BLE001 — see above
            fired, crashed = True, True
            detail = (f"PREDICATE CRASHED — {type(exc).__name__}: {exc}. Every OTHER "
                      f"predicate still ran; this one reported nothing, which is not the "
                      f"same as reporting nothing to report.")
        # A SNOOZE DOES NOT COVER A CRASH — not in the render, not in the exit code.
        # A snooze says "I know this FIRES, quiet it", never "I accept this predicate being
        # BROKEN". So a snoozed predicate that crashes still lands in render()'s ⚠ section
        # and still returns exit 2.
        #
        # THE PREVIOUS COMMENT HERE SAID IT RENDERED AS 💤, "verified", AND WAS WRONG BY THE
        # TIME IT WAS COMMITTED. It was true when written — `snoozed` is computed
        # independently of `crashed` — and then the crashed section was added to render() two
        # edits later, which claims a crashed predicate first. The verification was accurate
        # and the code moved underneath it. A "verified" claim is a fact about a MOMENT; if
        # you change the behaviour afterwards you own re-checking it (arbiter, 2026-08-09).
        s = snoozes.get(label, {}) if label in snoozed else {}
        out.append({"predicate": label, "fired": fired, "snoozed": label in snoozed,
                    "crashed": crashed, "detail": detail, "snooze_until": s.get("until"),
                    "snooze_reason": s.get("reason")})
    return out


def append_log(root: Path, results: list[dict]) -> None:
    """Append this run's fired set to the fire-log (feeds kill + graduate decisions).

    CRASHES ARE EXCLUDED. This log is the evidence base for retiring a predicate that never
    fires and graduating one that always does; a crash is the absence of a measurement, not
    a fire, and counting it as one would let a broken predicate look busy in exactly the
    statistics used to decide whether it earns its place.
    """
    log = root / ".tessera" / "logs" / "watch.jsonl"
    log.parent.mkdir(parents=True, exist_ok=True)
    entry = {
        "ts": datetime.now(timezone.utc).isoformat(),
        "fired": [r["predicate"] for r in results
                  if r["fired"] and not r["snoozed"] and not r.get("crashed")],
        "crashed": [r["predicate"] for r in results if r.get("crashed")],
    }
    with log.open("a") as f:
        f.write(json.dumps(entry) + "\n")


def render(results: list[dict]) -> str:
    """Three sections, and CRASHED IS ITS OWN — a crash is not a fire.

    `crashed` was added to the result dicts as a first-class concept and this function was
    left unaware of it for a day, so a run of "0 fired, 2 crashed" rendered identically in
    shape to "2 fired": same 🔴, same header claiming triggers FIRED. Missing coverage read
    as findings (arbiter, 2026-08-09). Distinct from the exit-code fix, which taught the
    SURFACER the difference while the human-facing text still conflated them — a mechanism
    can reach one audience and not the other (#9).

    The final line matters too: with no fires but a crash present, "no triggers fired" is
    true and misleading, because nothing can be concluded about the predicates that died.
    """
    crashed = [r for r in results if r.get("crashed")]
    fired = [r for r in results if r["fired"] and not r["snoozed"] and not r.get("crashed")]
    snoozed = [r for r in results if r["fired"] and r["snoozed"] and not r.get("crashed")]
    lines = []
    if crashed:
        lines.append(f"⚠ {len(crashed)} PREDICATE(S) COULD NOT RUN — this session's "
                     f"observatory coverage is INCOMPLETE, not clean:")
        lines += [f"  ⚠ {r['predicate']}: {r['detail']}" for r in crashed]
    if fired:
        lines.append("Observatory triggers fired (docs/observatory.md — resolve or snooze):")
        lines += [f"  🔴 {r['predicate']}: {r['detail']}" for r in fired]
    for r in snoozed:
        lines.append(f"  💤 {r['predicate']}: snoozed until {(r['snooze_until'] or '?')[:10]}"
                     f" — {r['snooze_reason'] or ''}")
    if not lines:
        return "✓ no Observatory triggers fired"
    if crashed:
        # UNCONDITIONAL when anything crashed. This first read `not fired and crashed`,
        # which left the MIXED case — some fires, some crashes — with no incompleteness
        # notice at all, so an operator reads the fired set as the whole picture. That is
        # the same defect the crashed section was added to fix, surviving in the one shape
        # it was not tested against (arbiter, 2026-08-09).
        lines.append(f"({len(crashed)} predicate(s) could not run, so this list is "
                     f"INCOMPLETE — absence of a trigger below is not evidence of absence.)")
    return "\n".join(lines)


def manage_snooze(root: Path, args, now: datetime) -> str:
    """Handle --snooze / --snooze-clear / --snooze-list. Returns a status line."""
    snoozes = _load_snoozes(root)
    if args.snooze_list:
        return "\n".join(f"  💤 {k}: until {v.get('until', '?')[:10]} — {v.get('reason', '')}"
                         for k, v in sorted(snoozes.items())) or "no active snoozes"
    if args.snooze_clear:
        label = _resolve_label(args.snooze_clear)
        if not label or label not in snoozes:
            return f"no snooze matching '{args.snooze_clear}'"
        del snoozes[label]
        _write_snoozes(root, snoozes)
        return f"cleared snooze on {label}"
    label = _resolve_label(args.snooze)
    if not label:
        return f"no unique predicate matches '{args.snooze}' — of: {', '.join(PREDICATES)}"
    if not args.reason:
        return "refusing to snooze without --reason (a snooze is an auditable decision)"
    until = (now + timedelta(days=args.days)).isoformat()
    snoozes[label] = {"until": until, "reason": args.reason, "snoozed_at": now.isoformat()}
    _write_snoozes(root, snoozes)
    return f"snoozed {label} until {until[:10]} ({args.days}d) — {args.reason}"


def main() -> int:
    ap = argparse.ArgumentParser(description="Evaluate Observatory silent+checkable triggers.")
    ap.add_argument("--json", action="store_true", help="machine output")
    ap.add_argument("--log", action="store_true", help="append run to .tessera/logs/watch.jsonl")
    ap.add_argument("--snooze", metavar="PREDICATE", help="ack+quiet a predicate (substring of its label)")
    ap.add_argument("--days", type=int, default=30, help="snooze window in days (with --snooze)")
    ap.add_argument("--reason", default="", help="why — required with --snooze (auditable)")
    ap.add_argument("--snooze-clear", metavar="PREDICATE", help="remove a snooze")
    ap.add_argument("--snooze-list", action="store_true", help="show active snoozes")
    args = ap.parse_args()

    if args.snooze or args.snooze_clear or args.snooze_list:
        print(manage_snooze(ROOT, args, datetime.now(timezone.utc)))
        return 0

    results = evaluate(ROOT)
    if args.log:
        append_log(ROOT, results)
    print(json.dumps(results, indent=2) if args.json else render(results))
    # 2 BEFORE 1, and the order is the fix. `tessera-watch-surface.sh` reads 0 as "nothing
    # fired", 1 as "something fired", anything else as a crash — but an unhandled exception
    # also exits 1, so before this a dead watcher was indistinguishable from a firing one and
    # the surfacer printed an OBSERVATORY WATCH header over an empty body. Measured, not
    # assumed: no `degraded` event was written in that state.
    if any(r.get("crashed") for r in results):
        return 2
    return 1 if any(r["fired"] and not r["snoozed"] for r in results) else 0


if __name__ == "__main__":
    # ANY unhandled failure exits 2, not Python's default 1. `tessera-watch-surface.sh`
    # discriminates 0 = nothing fired, 1 = something fired, anything else = crash — and
    # Python's default collides with "fired", so a dead watcher was indistinguishable from
    # a firing one and the session got an OBSERVATORY WATCH header over an empty body.
    #
    # `evaluate()` already isolates a crashing PREDICATE, but that fixed the row: a failure
    # in render(), append_log(), snooze handling or argument parsing would still exit 1 and
    # be misread. This is the class (#11). The traceback still goes to stderr for a human.
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except BaseException:
        import traceback
        traceback.print_exc()
        raise SystemExit(2)
