#!/usr/bin/env python3
"""tessera-verify — spawn an independent falsifier against explicit claims (spec 12).

The most effective mechanism on 2026-07-12 was an independent session told to refute
"it's fixed" claims: 3 runs, 3 refutations, all correct. This makes that a channel.

    tessera-verify --claim "the guard blocks unauthorized boots" [--claim ...]
    tessera-verify --self-test          # plant a known-false claim; expect REFUTED
    tessera-verify skip --reason "..."  # auditable opt-out for detector over-counts
    tessera-verify stats                # author-error rate across all sessions

The verifier runs in a throwaway git worktree (uncommitted + untracked state copied
in), so "leave the tree exactly as found" is structural — tier 1 — not an instruction
the verifier could ignore. It is told to falsify, to distrust comments, to plant
landmines, and to report without fixing. Verdicts land as a `verification` event in
`.tessera/logs/<session>.jsonl` (docs/contracts/verification-event.md).

The verifier returns its verdicts by WRITING A FILE in the worktree, not by saying them
in its final message. The final message is not a channel this tool controls: a Stop hook
in the spawned session can fire and replace it after the work is done, which is exactly
what happened on 2026-07-26 — three runs, zero usable verdicts, and the verification had
actually been performed every time. Scraping the final message remains as a fallback, and
the event records `verdict_channel` so a silent regression to it is visible.

Exit 0 only when every claim is CONFIRMED (or a --self-test landmine is REFUTED).
A missing or unparseable verdict is NEVER green.
"""

# Runs on ANY python3 — including macOS's /usr/bin/python3 (3.9). PEP-604 annotations
# raise TypeError at definition time there; this import makes them lazy strings. Do
# not remove. (F-001 / doccheck `safety-scripts-run-on-system-python`.)
from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

LOGS = Path(".tessera/logs")
DEFAULT_MODEL = "opus"
DEFAULT_TIMEOUT = 900
MAX_TURNS = 50

SELF_TEST_CLAIM = "The file scripts/doccheck.py is empty (zero bytes)."

VERDICT_RE = re.compile(r"^VERDICT\s+(\d+):\s*(CONFIRMED|REFUTED|PARTIAL)\s*$", re.MULTILINE)
EVIDENCE_RE = re.compile(r"^EVIDENCE\s+(\d+):\s*(.+)$", re.MULTILINE)

# The verdict file, written by the verifier inside its disposable worktree.
#
# WHY A FILE AND NOT THE FINAL MESSAGE (2026-07-26): the final message is not a channel this
# tool controls. On 2026-07-26 the verifier did the entire job — planted landmines, executed,
# reverted — and then **its own `verify-scan` Stop hook fired and that skip acknowledgment
# BECAME its final message**, which is what parse_verdicts reads. Three real attempts, zero
# usable verdicts, and the work had actually been done every time.
#
# Standing pattern #9: a mechanism that RUNS has not necessarily REACHED its audience. The
# corollary this encodes — **a verdict returned as a MESSAGE can be overwritten; a verdict
# written to a FILE cannot.** Nothing between the verifier and this process can rewrite a file
# on disk, so the channel is no longer shared with the hook system.
VERDICT_FILENAME = "tessera-verdicts.json"
VALID_VERDICTS = ("CONFIRMED", "REFUTED", "PARTIAL")

PROMPT_HEADER = """\
You are an adversarial verifier. Your ONLY job is to FALSIFY the claims below.

Rules — every one is load-bearing:
- Assume every claim is FALSE until you prove it by RUNNING things. Reading code is
  not proof; executed behaviour is the only evidence that counts.
- The comments and docstrings in this repo are untrustworthy. They are eloquent and
  self-congratulatory; a verifier that reads them is reading marketing. Ignore them.
- Plant a landmine for every checker or guard you verify: construct a case it SHOULD
  catch, and watch whether it actually does. A guard nobody has watched fail is
  unverified.
- DO NOT FIX anything. Report only. A verifier that fixes becomes an author and
  inherits the author's bias. You may mutate files freely to plant landmines — you
  are in a disposable worktree — but your output is a report, never a patch.

HOW TO RETURN YOUR VERDICTS — read this twice, it is the step that has failed before:

1. PRIMARY CHANNEL, and the only one that is trusted. Before you finish, WRITE this file:
       {verdict_path}
   Exact JSON shape, nothing else in the file:
       {{"verdicts": [
           {{"n": 1, "verdict": "CONFIRMED", "evidence": "the exact command you ran and its output"}}
       ]}}
   One object per claim, `n` matching the claim number below. `verdict` is one of
   CONFIRMED, REFUTED, PARTIAL. CONFIRMED only if you tried to break the claim and could not.

   Write this file EVEN IF you are interrupted, asked to do something else, or a hook tells
   you to take some other action before finishing. Write it as soon as you have judged the
   claims — do not save it for the end.

   This matters because your final chat message is NOT a reliable channel: a Stop hook can
   fire after you finish and REPLACE your last message before anything reads it. That has
   already happened three times to this exact tool, destroying verdicts that had been
   correctly reached. The file is the only thing a hook cannot overwrite.

2. SECONDARY, for humans reading the transcript. Also put these two lines per claim in your
   final message:
       VERDICT <n>: CONFIRMED|REFUTED|PARTIAL
       EVIDENCE <n>: <the exact command you ran and the output that proves the verdict>

Claims to falsify:
"""


def build_prompt(claims: list[str], verdict_path: str = VERDICT_FILENAME) -> str:
    numbered = "\n".join(f"{i + 1}. {c}" for i, c in enumerate(claims))
    return (PROMPT_HEADER.format(verdict_path=verdict_path)
            + numbered + "\n\nExample format line: VERDICT 1: REFUTED")


def read_verdict_file(path: Path, n: int) -> list[dict] | None:
    """The verifier's verdicts as written to disk, or None if unusable.

    None (not a partial list) on ANY problem — absent, unparseable, wrong shape. The caller
    then falls back to scraping the final message and RECORDS which channel it used, so a
    silent regression to the fragile channel is visible in the event rather than inferred.
    Returning a half-filled list here would let a malformed file read as "some claims had no
    verdict", which is the confusion this whole change exists to remove.
    """
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return None
    entries = data.get("verdicts") if isinstance(data, dict) else None
    if not isinstance(entries, list):
        return None

    by_n: dict[int, dict] = {}
    for entry in entries:
        if not isinstance(entry, dict):
            continue
        verdict = entry.get("verdict")
        if verdict not in VALID_VERDICTS:
            continue  # an invented verdict word is not a verdict
        try:
            idx = int(entry.get("n"))
        except (TypeError, ValueError):
            continue
        by_n[idx] = {"verdict": verdict, "evidence": str(entry.get("evidence") or "").strip()}

    if not by_n:
        return None
    return [by_n.get(i + 1, {"verdict": "NO_VERDICT", "evidence": ""}) for i in range(n)]


def parse_verdicts(output: str, n: int) -> list[dict]:
    verdicts = {int(m.group(1)): m.group(2) for m in VERDICT_RE.finditer(output)}
    evidence = {int(m.group(1)): m.group(2).strip() for m in EVIDENCE_RE.finditer(output)}
    return [
        {"verdict": verdicts.get(i + 1, "NO_VERDICT"), "evidence": evidence.get(i + 1, "")}
        for i in range(n)
    ]


def _utc_now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def build_event(
    claims: list[str],
    verdicts: list[dict],
    session_id: str,
    *,
    self_test: bool = False,
    skipped: bool = False,
    reason: str | None = None,
    model: str = DEFAULT_MODEL,
    spawn_error: str | None = None,
    raw_output: str | None = None,
    verdict_channel: str | None = None,
) -> dict:
    data: dict = {
        "claims": [
            {"text": c, "verdict": v["verdict"], "evidence": v["evidence"]}
            for c, v in zip(claims, verdicts)
        ],
        "self_test": self_test,
        "skipped": skipped,
        "model": model,
    }
    # Which channel the verdicts actually came from: "file" (the verifier wrote the JSON) or
    # "final-message" (it did not, and we scraped the transcript). Recorded on EVERY judged run,
    # not just failures — the fragile channel silently becoming the norm again is precisely the
    # regression worth seeing, and you cannot see it from the verdicts alone.
    if verdict_channel:
        data["verdict_channel"] = verdict_channel
    if reason:
        data["reason"] = reason
    # A run the verifier could not perform is recorded — silence would be worse — but it is
    # NOT a disposition. scripts/verify/scan.py refuses to count these, so a blocked verifier
    # can no longer silence the Stop-hook backstop.
    if spawn_error:
        data["spawn_error"] = spawn_error
    # NO_VERDICT means "the verifier answered unparseably" — but the answer was thrown away,
    # so nobody could ever see WHAT it said. Observed 2026-07-21: a 1-claim run parsed, a
    # 2-claim run did not, and the difference was undiagnosable because only the parsed
    # verdicts were kept. VERDICT_RE is end-of-line anchored, so any decoration ("**VERDICT
    # 1: CONFIRMED**", a trailing clause) silently misses. Keep the evidence of the failure.
    if raw_output is not None and any(v["verdict"] == "NO_VERDICT" for v in verdicts):
        data["raw_excerpt"] = raw_output[-2000:]
    return {
        "type": "verification",
        "ts": _utc_now_iso(),
        "session_id": session_id,
        "source": "tessera-verify",
        "data": data,
    }


def append_event(event: dict) -> Path:
    path = LOGS / f"{event['session_id']}.jsonl"
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "a") as f:
        f.write(json.dumps(event, ensure_ascii=False) + "\n")
    return path


# --- worktree ------------------------------------------------------------------


def _git(root: Path, *args: str, **kw) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(root), *args], check=True, capture_output=True, **kw)


def make_worktree(root: Path) -> Path:
    """Detached worktree at HEAD + uncommitted diff + untracked files copied in.

    Restoration is structural: the verifier can do anything it likes in here and
    the source tree cannot be affected. remove_worktree deletes the whole thing.
    """
    wt = Path(tempfile.mkdtemp(prefix="tessera-verify-"))
    _git(root, "worktree", "add", "--detach", str(wt), "HEAD")
    diff = subprocess.run(
        ["git", "-C", str(root), "diff", "HEAD", "--binary"], check=True, capture_output=True
    ).stdout
    if diff.strip():
        subprocess.run(["git", "-C", str(wt), "apply"], input=diff, check=True)
    untracked = _git(root, "ls-files", "--others", "--exclude-standard").stdout.decode().splitlines()
    for rel in untracked:
        src, dst = root / rel, wt / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
    return wt


def remove_worktree(root: Path, wt: Path) -> None:
    subprocess.run(
        ["git", "-C", str(root), "worktree", "remove", "--force", str(wt)],
        capture_output=True,
    )
    shutil.rmtree(wt, ignore_errors=True)
    # `remove` deliberately ignores its exit code (cleanup must never raise over the verdict),
    # but that means a failed removal leaves a dangling admin record in .git/worktrees forever
    # — observed after the 2026-07-26 self-test. `prune` clears exactly the records whose
    # directory is gone, so it cannot touch a live worktree someone else is using.
    subprocess.run(["git", "-C", str(root), "worktree", "prune"], capture_output=True)


# --- spawn ----------------------------------------------------------------------


class VerifierDidNotRun(Exception):
    """The verifier process never produced a judgement — distinct from judging badly."""


def spawn_verifier(prompt: str, cwd: Path, model: str, timeout: int) -> str:
    """Headless claude, clean context, cwd = the disposable worktree.

    THIS FUNCTION USED TO `return result.stdout` AND DISCARD returncode AND stderr. A spawn
    that never ran returned "" — which parse_verdicts rendered as NO_VERDICT, indistinguishable
    from a verifier that ran and answered unparseably. Found 2026-07-21: the nested
    `claude -p --dangerously-skip-permissions` is refused by the permission classifier when
    tessera-verify is invoked from inside a Claude Code session, and the refusal was silent.

    That is the exact failure shape this tool exists to catch, inside the tool itself: the
    falsifier failing open. Worse than cosmetic — scripts/verify/scan.py counted the resulting
    event as "this session dispositioned verification", so a verifier that never executed
    silenced the Stop-hook backstop.

    A verifier that could not run is not a verdict. Raise, loudly.
    """
    try:
        result = subprocess.run(
            [
                "claude",
                "-p",
                prompt,
                "--model",
                model,
                "--max-turns",
                str(MAX_TURNS),
                "--dangerously-skip-permissions",
            ],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except FileNotFoundError as e:
        raise VerifierDidNotRun("the `claude` CLI is not on PATH") from e
    except subprocess.TimeoutExpired as e:
        raise VerifierDidNotRun(f"verifier exceeded the {timeout}s timeout") from e

    if result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip() or "no output on either stream"
        raise VerifierDidNotRun(f"claude exited {result.returncode}: {detail[:600]}")
    if not result.stdout.strip():
        detail = (result.stderr or "").strip() or "no output on either stream"
        raise VerifierDidNotRun(f"claude exited 0 but produced no stdout: {detail[:600]}")
    return result.stdout


# --- commands ---------------------------------------------------------------------


def _session_id() -> str:
    return os.environ.get("CLAUDE_CODE_SESSION_ID") or "manual"


def cmd_run(args: argparse.Namespace) -> int:
    claims = [SELF_TEST_CLAIM] if args.self_test else list(args.claim)
    if not claims:
        print("no claims: pass --claim (or --self-test)", file=sys.stderr)
        return 2
    root = Path.cwd()
    wt = make_worktree(root)
    verdict_file = wt / VERDICT_FILENAME
    # A verdict file that predates this run is not a verdict. make_worktree copies UNTRACKED
    # files from the source tree into the worktree, so a stale tessera-verdicts.json left in
    # the repo root would arrive here and be read as authoritative — CONFIRMED verdicts with
    # the verifier never having written a thing. That is the falsifier failing open, which is
    # the failure this whole file-channel change exists to fix; it would have been reintroduced
    # BY the fix. Deleting is the authoritative guard: .gitignore also lists the file, but a
    # `git add --force`, a different cwd, or a downstream without that ignore rule all defeat
    # an ignore rule, and none of them defeat an unlink.
    verdict_file.unlink(missing_ok=True)
    try:
        output = spawn_verifier(
            build_prompt(claims, str(verdict_file)), wt, args.model, args.timeout
        )
        # MUST happen before the `finally` deletes the worktree. The previous shape parsed
        # verdicts after the try/finally, which was harmless while the only source was a
        # captured string — it is fatal once the source is a file inside the worktree.
        from_file = read_verdict_file(verdict_file, len(claims))
    except VerifierDidNotRun as e:
        append_event(
            build_event(
                claims,
                [{"verdict": "NO_VERDICT", "evidence": ""} for _ in claims],
                _session_id(),
                self_test=args.self_test,
                model=args.model,
                spawn_error=str(e),
            )
        )
        print(f"VERIFIER DID NOT RUN — {e}", file=sys.stderr)
        print("This is NOT a verdict. Nothing was verified, and this run does NOT", file=sys.stderr)
        print("disposition the Stop-hook backstop. Fix the spawn, or record an", file=sys.stderr)
        print('auditable opt-out: tessera-verify skip --reason "..."', file=sys.stderr)
        return 2
    finally:
        remove_worktree(root, wt)
    if from_file is not None:
        verdicts, channel = from_file, "file"
    else:
        verdicts, channel = parse_verdicts(output, len(claims)), "final-message"
    event = build_event(
        claims, verdicts, _session_id(), self_test=args.self_test, model=args.model,
        raw_output=output, verdict_channel=channel,
    )
    append_event(event)
    for c, v in zip(claims, verdicts):
        print(f"{v['verdict']:<11} {c}")
        if v["evidence"]:
            print(f"            {v['evidence']}")
    if channel == "final-message":
        print(
            "\nNOTE: the verifier did not write the verdict file; these verdicts were scraped\n"
            "from its final message. That channel is not reliable — a Stop hook can replace the\n"
            "final message after the work is done, which is how three earlier runs lost verdicts\n"
            "they had correctly reached. Treat NO_VERDICT here as 'channel failed', not 'no answer'.",
            file=sys.stderr,
        )
    if args.self_test:
        ok = verdicts[0]["verdict"] == "REFUTED"
        print("self-test: " + ("PASS — landmine refuted" if ok else "FAIL — verifier is broken"))
        return 0 if ok else 1
    return 0 if all(v["verdict"] == "CONFIRMED" for v in verdicts) else 1


def cmd_skip(args: argparse.Namespace) -> int:
    event = build_event([], [], _session_id(), skipped=True, reason=args.reason)
    path = append_event(event)
    print(f"verification skip recorded → {path}")
    return 0


def stats_summary(logs_dir: Path) -> dict:
    counts = {"confirmed": 0, "refuted": 0, "partial": 0, "no_verdict": 0, "skips": 0}
    # Which CHANNEL each run's verdicts arrived on. A regression from `file` back to
    # `message` is the 2026-07-26 failure — the verifier did the whole job, then its own
    # verify-scan Stop hook overwrote the final message and `parse_verdicts` read the skip
    # acknowledgment instead. 0 usable verdicts in 3 real attempts, and nothing said so.
    #
    # `unrecorded` is a DELIBERATE third bucket, not a tidy-up. `verdict_channel` was added
    # by that fix, so every run before it has no channel field. Defaulting those to "message"
    # would manufacture a regression signal out of history that predates the measurement —
    # the reader would see message-channel verdicts and conclude the fix had come undone.
    channels: dict[str, int] = {}
    for log in sorted(logs_dir.glob("*.jsonl")):
        for line in log.read_text().splitlines():
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if ev.get("type") != "verification":
                continue
            data = ev.get("data", {})
            if data.get("skipped"):
                counts["skips"] += 1
                continue
            ch = data.get("verdict_channel") or "unrecorded"
            channels[ch] = channels.get(ch, 0) + 1
            for claim in data.get("claims", []):
                key = claim.get("verdict", "NO_VERDICT").lower()
                counts[key if key in counts else "no_verdict"] += 1
    counts["channels"] = channels
    judged = counts["confirmed"] + counts["refuted"] + counts["partial"]
    counts["author_error_rate"] = (
        (counts["refuted"] + counts["partial"]) / judged if judged else None
    )
    return counts


def cmd_stats(_args: argparse.Namespace) -> int:
    s = stats_summary(LOGS)
    rate = "n/a (no judged claims yet)" if s["author_error_rate"] is None else f"{s['author_error_rate']:.0%}"
    print(
        f"claims: {s['confirmed']} confirmed / {s['refuted']} refuted / "
        f"{s['partial']} partial / {s['no_verdict']} no-verdict; skips: {s['skips']}"
    )
    print(f"author error rate on 'it's fixed': {rate}   (2026-07-12 prior: 100%, n=3)")

    ch = s["channels"]
    if ch:
        # Ordered file-first: `file` is the fix, `message` is the regression, and a reader
        # scanning the line should hit the number that matters before the historical one.
        order = sorted(ch, key=lambda k: {"file": 0, "message": 1}.get(k, 2))
        print("verdict channel: " + " / ".join(f"{ch[k]} {k}" for k in order))
        if ch.get("message"):
            print("  ⚠ a run landed on the MESSAGE channel — the 2026-07-26 failure mode, "
                  "where a Stop hook overwrites the final message and the verdicts vanish.")
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description="Adversarial verification of explicit claims.")
    sub = p.add_subparsers(dest="cmd")

    run = sub.add_parser("run", help="falsify claims (default)")
    skip = sub.add_parser("skip", help="record an auditable opt-out")
    skip.add_argument("--reason", required=True)
    sub.add_parser("stats", help="author-error rate across sessions")

    for target in (p, run):
        target.add_argument("--claim", action="append", default=[])
        target.add_argument("--self-test", action="store_true")
        target.add_argument("--model", default=DEFAULT_MODEL)
        target.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT)

    args = p.parse_args(argv)
    if args.cmd == "skip":
        return cmd_skip(args)
    if args.cmd == "stats":
        return cmd_stats(args)
    return cmd_run(args)


if __name__ == "__main__":
    sys.exit(main())
