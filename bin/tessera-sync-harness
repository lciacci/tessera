#!/usr/bin/env python3
"""Back-fill harness components into an EXISTING Tessera project.

THE GAP THIS CLOSES. `tessera-new-project` ships the harness at scaffold time and nothing ever
revisits it. Every component added later exists only in projects scaffolded after it. Measured
2026-07-22 across the fleet:

  tess-dashboard  no gate harness AT ALL — no emit.py, no scan.py, no gate-scan hook, no escalate
  howler          no spend guard (scripts or hook wiring)
  all four pre-settempo repos   no remap_kind.py, and no SQL gate (shipped today)

CORRECTION (2026-07-22, same day): an earlier version of this docstring claimed those four
repos' gate suites were BROKEN because test_gate_emit.py imports remap_kind.py. That is FALSE
and was never checked before being written down — they carry OLDER copies of test_gate_emit.py
that never import it, and howler's suite passes. The real gap in those repos is STALENESS, not
absence: their emit.py has no KINDS enum (spec 15) and no --not-a-gate, their scan.py has no
turn_id (F-001 disposition memory).

That distinction bounds this tool. It ONLY ADDS. It cannot fix a stale component, only a
missing one, and it deliberately reports present-but-different files rather than replacing
them. Updating a stale harness is a separate problem and needs a separate decision per file,
because a downstream may have customized.

That is "ship both halves or neither" violated by TIME rather than by a missing `cp`. The
scaffold gained two components today alone, so this recurs by construction.

WHY IT SCAFFOLDS A REFERENCE PROJECT INSTEAD OF LISTING FILES. A hardcoded list here would be a
second definition of "what the harness is", drifting from `tessera-new-project` the moment
either changes — which is F-003's exact shape, one layer up, and the thing this tool exists to
clean up. Instead it runs the real scaffold into a temp dir and diffs against that. The scaffold
stays the single source of truth; this tool cannot disagree with it.

SAFETY: only ever ADDS. Never overwrites a file that exists, never touches project-identity
files, and reports drifted-but-present files rather than "fixing" them — a project may have
customized deliberately, and overwriting unread content is exactly what the base skill forbids.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

TESSERA_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(TESSERA_ROOT / "scripts" / "hooks"))
import anchor_settings  # noqa: E402  (path set above; stdlib-only, safe under any python3)
import report_settings  # noqa: E402  (spec 11: wired hooks that cannot run must say so)

# Files the scaffold writes that belong to the PROJECT, not the harness. Never back-fill these:
# they carry identity (name, description, test command, findings) or are merged, not copied.
# NOTE: .sqlfluff is deliberately NOT here. It is a harness default (the scaffold ships one),
# and lint.sh without it runs stock rules = 89% whitespace noise — the broken half. Projects
# that already have one keep it, because this tool only ever adds.
IDENTITY = {
    "CLAUDE.md", ".gitignore",
    ".tessera/project.yml", ".tessera/config.yml", ".tessera/security-exceptions.yml",
    ".claude/settings.json",          # merged separately — never wholesale copied
    "docs/FINDINGS.md",               # carries real findings
    ".mnemos/.gitignore", ".tessera/logs/README.md",
}
SKIP_DIRS = (".git/", ".icpg/", ".mnemos/")


def reference_scaffold(tmp: Path) -> Path:
    """A pristine project from the REAL scaffold — the single source of truth."""
    target = tmp / "reference"
    r = subprocess.run(
        [str(TESSERA_ROOT / "bin" / "tessera-new-project"), str(target), "reference", "standard"],
        capture_output=True, text=True, timeout=180,
    )
    if r.returncode != 0:
        raise SystemExit(f"reference scaffold failed:\n{r.stderr}")
    return target


def harness_files(root: Path) -> dict[str, Path]:
    out = {}
    for p in sorted(root.rglob("*")):
        if not p.is_file():
            continue
        rel = p.relative_to(root).as_posix()
        if rel in IDENTITY or any(rel.startswith(d) for d in SKIP_DIRS):
            continue
        out[rel] = p
    return out


def missing_hooks(reference: dict, target: dict) -> list[tuple[str, dict]]:
    """Hook entries in the reference that the target lacks, keyed by the script they invoke.

    Copying a script without wiring the hook that calls it ships a component that looks
    installed and never runs — the same half-shipped failure this tool exists to fix. Matching
    is by script basename, so a project that reworded its command is left alone.
    """
    def scripts_of(settings: dict) -> set[str]:
        found = set()
        for groups in settings.get("hooks", {}).values():
            for g in groups:
                for h in g.get("hooks", []):
                    for token in h.get("command", "").split():
                        if ".sh" in token:
                            found.add(token.strip('";').split("/")[-1])
        return found

    have = scripts_of(target)
    out = []
    for event, groups in reference.get("hooks", {}).items():
        for g in groups:
            for h in g.get("hooks", []):
                cmd = h.get("command", "")
                if "mnemos" in cmd:
                    continue          # mnemos wiring is ADR-0004's business, not this tool's
                names = {t.strip('";').split("/")[-1] for t in cmd.split() if ".sh" in t}
                if names and not (names & have):
                    out.append((event, h))
    return out


def _sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def known_tessera_versions(rel: str) -> set[str]:
    """Every blob this path has ever had in tessera's history, by sha256.

    This is the PROOF that makes updating a stale file safe. "Only ever adds" was the right
    default while customization was possible, but a file that is byte-identical to some commit
    in tessera's own history was demonstrably never edited downstream — there is nothing to
    lose by replacing it. Anything matching NO known version is left alone and reported: it
    was either customized or came from somewhere this tool cannot vouch for.

    Not a heuristic. Either the bytes appear in our history or they do not.
    """
    # The scaffold does not always preserve the path: scripts/tessera-escalate is copied from
    # bin/tessera-escalate. Check both shapes rather than hardcoding a rename table.
    candidates = {rel, f"bin/{Path(rel).name}"}
    seen: set[str] = set()
    for path in candidates:
        commits = subprocess.run(
            ["git", "-C", str(TESSERA_ROOT), "log", "--format=%H", "--", path],
            capture_output=True, text=True).stdout.split()
        for commit in commits:
            blob = subprocess.run(
                ["git", "-C", str(TESSERA_ROOT), "show", f"{commit}:{path}"],
                capture_output=True).stdout
            if blob:
                seen.add(_sha(blob))
    return seen


def patch_settings_only(project: Path, apply: bool) -> int:
    """Anchor EXISTING cwd-relative hook commands in the project's settings.json — and NOTHING
    else. Kept separate from sync() on purpose: bundling anchoring with the file/hook back-fill
    meant `--patch-settings --apply` also installed missing components — it back-filled howler's
    DEFERRED spend guard mid-iOS-ship (2026-07-24). Anchoring must never carry that payload.
    """
    tgt = project / ".claude" / "settings.json"
    if not tgt.exists():
        print(f"no .claude/settings.json in {project}", file=sys.stderr)
        return 2
    settings = json.loads(tgt.read_text())
    # Both COMMAND-BODY rewrites: anchor cwd-relative paths, and give local-only hooks a
    # reporting else-branch so one that cannot be exec'd stops exiting 0 in silence (spec 11).
    # Adding the second rewrite here does NOT re-open the howler accident: that was caused by
    # bundling COMPONENT INSTALLATION with settings patching. Both of these are settings-only
    # and install nothing, which is the invariant that actually matters.
    # ORDER MATTERS: report_settings only matches an ANCHORED path, because reporting on a path
    # that still moves with the session cwd would name the wrong file. Reversed, this silently
    # reports nothing on an unanchored project — a no-op that reads as success.
    _, anchored = anchor_settings.anchor(settings)
    _, reported = report_settings.add_reporting(settings)
    if not anchored and not reported:
        print("settings.json already anchored and reporting — nothing to patch")
        return 0
    if apply:
        tgt.write_text(json.dumps(settings, indent=2) + "\n")
    verb = "" if apply else "would "
    if anchored:
        print(f"{verb}anchor {len(anchored)} cwd-relative hook command(s): "
              f"{', '.join(sorted(set(anchored)))}")
    if reported:
        print(f"{verb}add hook-unavailable reporting to {len(reported)} wired command(s): "
              f"{', '.join(sorted(set(reported)))}")
    if not apply:
        print("re-run with --apply to write.")
    return 0


def sync(project: Path, apply: bool, exclude: list[str] | None = None,
         update_stale: bool = False) -> int:
    exclude = exclude or []
    with tempfile.TemporaryDirectory() as td:
        ref_root = reference_scaffold(Path(td))
        ref = harness_files(ref_root)
        # --exclude exists for one concrete case: the spend guard is a PreToolUse hook that
        # DENIES by default. Adding it to a repo mid-release can block a build or upload at the
        # worst moment. "Back-fill everything except the component that says no, for now" is a
        # real posture, and it should be a recorded choice rather than a reason to skip the
        # whole back-fill and leave a broken gate suite in place.
        if exclude:
            ref = {rel: src for rel, src in ref.items()
                   if not any(e in rel for e in exclude)}

        added, drifted = [], []
        for rel, src in ref.items():
            dst = project / rel
            if not dst.exists():
                added.append(rel)
                if apply:
                    dst.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(src, dst)
                    if src.stat().st_mode & 0o111:
                        dst.chmod(dst.stat().st_mode | 0o755)
            elif dst.read_bytes() != src.read_bytes():
                drifted.append(rel)

        # Stale-but-unmodified files: provably safe to update (see known_tessera_versions).
        updated, customized = [], []
        if update_stale:
            for rel in drifted:
                current = (project / rel).read_bytes()
                if _sha(current) in known_tessera_versions(rel):
                    updated.append(rel)
                    if apply:
                        shutil.copy2(ref[rel], project / rel)
                else:
                    customized.append(rel)
            drifted = []

        # Copying .githooks/pre-commit without pointing git at it ships a hook git never runs
        # — the same half-shipment this tool exists to fix, committed by the tool itself.
        hooks_path_set = False
        shadowed: list[str] = []
        if apply and (project / ".githooks" / "pre-commit").exists():
            current = subprocess.run(["git", "-C", str(project), "config", "core.hooksPath"],
                                     capture_output=True, text=True).stdout.strip()
            # core.hooksPath redirects git AWAY from .git/hooks. Setting it where real hooks
            # already live would silently disable every one of them — this tool would be
            # committing the same class of invisible breakage it was written to repair.
            # .git/hooks is untracked, so those hooks exist on one disk and nowhere else and
            # nothing else would ever report their loss.
            hooks_dir = project / ".git" / "hooks"
            if hooks_dir.is_dir():
                shadowed = sorted(f.name for f in hooks_dir.iterdir()
                                  if f.is_file() and not f.name.endswith(".sample"))
            if not current and not shadowed:
                subprocess.run(["git", "-C", str(project), "config", "core.hooksPath", ".githooks"],
                               capture_output=True)
                hooks_path_set = True

        ref_settings = json.loads((ref_root / ".claude" / "settings.json").read_text())
        tgt_path = project / ".claude" / "settings.json"
        tgt_settings = json.loads(tgt_path.read_text()) if tgt_path.exists() else {}
        hooks_to_add = missing_hooks(ref_settings, tgt_settings)
        # An excluded component's wiring must go too, or the hook points at a script that was
        # deliberately not copied — a dangling hook is worse than a missing one.
        if exclude:
            hooks_to_add = [(e, h) for e, h in hooks_to_add
                            if not any(x in h.get("command", "") for x in exclude)]
        if hooks_to_add and apply:
            tgt_settings.setdefault("hooks", {})
            for event, hook in hooks_to_add:
                tgt_settings["hooks"].setdefault(event, []).append({"hooks": [hook]})
            tgt_path.write_text(json.dumps(tgt_settings, indent=2) + "\n")

    verb = "added" if apply else "would add"
    print(f"{verb} {len(added)} file(s):")
    for rel in added:
        print(f"  + {rel}")
    print(f"{verb} {len(hooks_to_add)} hook wiring(s):")
    for event, hook in hooks_to_add:
        print(f"  + {event}: {hook.get('command','')[:80]}")
    if apply and hooks_path_set:
        print("set core.hooksPath = .githooks (git would never have run the hook otherwise)")
    elif apply and shadowed:
        print(f"\nDID NOT set core.hooksPath — .git/hooks holds {len(shadowed)} real hook(s): "
              f"{', '.join(shadowed)}")
        print("  Setting it would silently disable them. Merge by hand, then:")
        print("  git config core.hooksPath .githooks")
    if updated:
        print(f"\n{verb} {len(updated)} stale file(s) (byte-identical to a known tessera "
              f"version, so provably not customized):")
        for rel in updated:
            print(f"  ^ {rel}")
    if customized:
        print(f"\n{len(customized)} differ and match NO tessera version — NOT touched, "
              f"review by hand:")
        for rel in customized:
            print(f"  ! {rel}")
    if drifted:
        print(f"\n{len(drifted)} present but DIFFERENT — not touched (pass --update-stale "
              f"to refresh the provably-unmodified ones):")
        for rel in drifted:
            print(f"  ~ {rel}")
    if not apply and (added or hooks_to_add):
        print("\nre-run with --apply to write.")
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description="Back-fill harness components into a project.")
    ap.add_argument("project", nargs="?", default=".", type=Path)
    ap.add_argument("--apply", action="store_true", help="write changes (default: dry run)")
    ap.add_argument("--update-stale", action="store_true",
                    help="also refresh files that are byte-identical to a known tessera "
                         "version (provably not customized); never touches anything else")
    ap.add_argument("--exclude", action="append", default=[], metavar="SUBSTR",
                    help="skip components whose path contains SUBSTR (repeatable), "
                         "e.g. --exclude spend")
    ap.add_argument("--patch-settings", action="store_true",
                    help="anchor EXISTING cwd-relative hook commands in the project's "
                         ".claude/settings.json to ${CLAUDE_PROJECT_DIR:-.}. Anchor-ONLY: does "
                         "NOT back-fill files or hooks (bundling them installed a deferred "
                         "component by accident once). Run without this flag for back-fill.")
    args = ap.parse_args(argv)
    project = args.project.resolve()
    if not (project / ".tessera" / "project.yml").is_file():
        print(f"not a Tessera project: {project}", file=sys.stderr)
        return 2
    # Anchor-only and back-fill are separate operations; mixing them is what caused the
    # accidental spend-guard install. Refuse the ambiguous combination rather than guess.
    if args.patch_settings and (args.update_stale or args.exclude):
        print("--patch-settings is anchor-only; do not combine with --update-stale/--exclude "
              "(run a separate back-fill pass for those)", file=sys.stderr)
        return 2
    if args.patch_settings:
        return patch_settings_only(project, args.apply)
    return sync(project, args.apply, args.exclude, args.update_stale)


if __name__ == "__main__":
    raise SystemExit(main())
