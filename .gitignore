# OS
.DS_Store
Thumbs.db

# Editors
.vscode/settings.json
.idea/

# Dogfood wiring — machine-local symlinks into .claude/ for in-repo skill/command/agent
# discovery. Canonical source is the top-level skills/, commands/, agents/ dirs.
.claude/skills
.claude/commands
.claude/agents

# Tessera runtime
.tessera/logs/*
!.tessera/logs/README.md
.mnemos/
.icpg/
.claude/.tdd-iteration-count

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build artifacts
dist/
build/
*.egg-info/

# Secrets
.env
.env.*
!.env.example


# Live spend authorization — a run-scoped grant, never committed (spec 06)
.tessera/spend-auth.json

# Backstop fire-counter — per-session runtime state. TRACKED IT ONCE BY MISTAKE: a fresh
# clone inherited count=5 against MAX_FIRES=3, so the backstop was born disabled, silently.
.tessera/.spend-backstop-fires

# Verdict handoff file — tessera-verify's verifier writes this inside its disposable worktree.
# It must never be committed or left in the source tree: make_worktree copies untracked files
# INTO the worktree, so a stale one would be read as this run's verdicts. This is the second
# line of defence only — bin/tessera-verify unlinks it before every spawn, because an ignore
# rule is advisory (a --force add, another cwd, a downstream missing this line) and an unlink
# is not.
tessera-verdicts.json
