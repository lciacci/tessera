#!/bin/bash
# Tessera pre-commit — refuse a commit whose docs assert things that are not true.
#
# WHY THIS EXISTS: on 2026-07-11 commit 8589280 was pushed with doccheck RED. The verify
# command was chained with `&&`, doccheck's exit 1 short-circuited it, and the `git commit`
# on the next line ran anyway. The checker did its job; nothing was listening. **Green is
# only meaningful if failing it actually stops something.** doccheck was advisory at commit
# time and enforced only at session start (tessera-watch P8) — which means red could be
# pushed and discovered a session later, by which point it is in the history.
#
# WHY .githooks/ AND NOT .git/hooks/: .git/hooks/ is NOT tracked by git. A hook installed
# there exists on one disk and nowhere else — a fresh clone gets no gate, silently. That is
# the exact class that produced three separate bugs on 2026-07-11 (the gitignored config.yml,
# the interactive-only PATH, F-001's interpreter): **we validated against the environment we
# were standing in, not the one the code runs in.** This directory is committed, and
# `install.sh` points git at it (`core.hooksPath`) and verifies it stayed pointed.
#
# This gate is for BOTH readers: Lorenzo at a terminal and Claude via the Bash tool. git runs
# it either way, which is why the gate lives in git and not in a shell profile or a convention.
#
# Bypass with `git commit --no-verify` when you mean it. It is a gate, not a jail — but a
# bypass is a decision, and now it is one you have to make on purpose.
#
# KNOWN LIMIT: doccheck reads the WORKING TREE, not the index. On a partial commit (staged
# subset + dirty working tree) it judges content that is not exactly what you are committing.
# Accepted: near-100% of commits here are `git add -A`. Fixing it properly needs a temp
# checkout of the index, which is not worth the complexity until a partial commit bites.

ROOT="$(git rev-parse --show-toplevel)"
DOCCHECK="$ROOT/scripts/doccheck.py"

# SQL lint (ADR-0012). WARN-ONLY and silent unless this commit stages .sql — so in the four
# downstreams with no SQL, and in this repo (0 .sql files), it costs nothing and says nothing.
# Deliberately runs BEFORE doccheck's blocking gate: a warning you only see after a commit is
# refused for an unrelated reason is a warning you do not see.
[ -x "$ROOT/scripts/sql/lint.sh" ] && "$ROOT/scripts/sql/lint.sh"

[ -f "$DOCCHECK" ] || exit 0          # not the tessera repo (or a very old checkout)
command -v python3 >/dev/null 2>&1 || exit 0

OUTPUT=$(python3 "$DOCCHECK" 2>&1)
STATUS=$?

if [ "$STATUS" -eq 0 ]; then
    # THE WARN TIER'S ONLY DELIVERY CHANNEL (2026-08-17). doccheck exits 0 with warnings
    # present, and this hook used to print nothing at all on exit 0 — so a warn-tier check
    # would have run, reported, and reached NOBODY (#9). The commit still succeeds; the
    # point is that it succeeds *out loud*. Matched to the section header render() emits,
    # not to an emoji or a check name, so renaming a warn-tier check cannot silence this.
    if echo "$OUTPUT" | grep -q "warning(s) — reported, not blocking:"; then
        echo "" >&2
        echo "$OUTPUT" | sed -n '/warning(s) — reported, not blocking:/,$p' >&2
        echo "" >&2
    fi
    exit 0
fi

# Distinguish "docs are lying" (block) from "the checker itself broke" (warn, allow).
# A crashing checker must not wedge every commit in the repo — but it must never fail
# QUIETLY either, because a silent checker looks exactly like a passing one.
# TWO RECOGNISED VERDICTS, and the second was added 2026-08-10 with per-check isolation.
# A crashed CHECK now blocks: it is a real defect, it is named, and the other 44 checks
# still report. The fail-open below is for the CATASTROPHIC case only — doccheck itself
# unparseable, an exception in render(), a traceback with no recognisable verdict — which
# is what "must not wedge every commit" was written for. Without this second pattern the
# isolation would have silently INVERTED the decision: crashes print their own section, so
# the old grep would miss them and every crash would sail through.
if ! echo "$OUTPUT" | grep -qE "claim\(s\) that are no longer true|check\(s\) CRASHED"; then
    echo "warning: doccheck could not run (allowing commit)" >&2
    echo "$OUTPUT" >&2
    exit 0
fi

# The headline must match the CAUSE. Saying "the docs make claims that are not true" over a
# crashed check is the same mislabel that shipped in the checkpoint's omission notice this
# same day: a report can be true in aggregate and wrong about what happened (#12).
# THREE cases, not two. With per-check isolation a run can carry crashes AND false claims
# at once, and the first version tested the crash pattern first — so the headline said only
# "a check CRASHED" while real doc violations sat below it, silently demoted. That is the
# same defect this branch was added to fix, one case further along (arbiter 2026-08-10).
CRASHED=$(echo "$OUTPUT" | grep -c "check(s) CRASHED")
FALSE=$(echo "$OUTPUT" | grep -c "claim(s) that are no longer true")
FIX_DOC="Fix the doc, or the code it describes. If the claim is about something
deliberately unbuilt, park it in doccheck's PLANNED_PATHS with a reason."
FIX_CHECK="Fix the check. It raised rather than reporting; the other checks still ran."

if [ "$CRASHED" -gt 0 ] && [ "$FALSE" -gt 0 ]; then
    HEADLINE="COMMIT BLOCKED — a doccheck check CRASHED *and* the docs make false claims:"
    REMEDY="$FIX_CHECK
$FIX_DOC"
elif [ "$CRASHED" -gt 0 ]; then
    HEADLINE="COMMIT BLOCKED — a doccheck check CRASHED, so its claim went unverified:"
    REMEDY="$FIX_CHECK"
else
    HEADLINE="COMMIT BLOCKED — the docs in this commit make claims that are not true:"
    REMEDY="$FIX_DOC"
fi

echo "" >&2
echo "$HEADLINE" >&2
echo "" >&2
echo "$OUTPUT" >&2
echo "" >&2
echo "$REMEDY" >&2
echo "Override with: git commit --no-verify" >&2
echo "" >&2
exit 1
