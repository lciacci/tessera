#!/bin/bash
# ██ DO NOT WIRE — NON-FUNCTIONAL, AND ITS DESIGN IS WRONG FOR THIS REPO. ██
#
# Audited 2026-07-27 while wiring its sibling. Broken in three independent places, verified by
# running it, not by reading it:
#
#   1. Line ~43: `json.loads(sys.stdin)` — loads the FILE OBJECT, not its text, and the
#      condition `if sys.stdin.read()` has already consumed stdin. Always raises, always caught
#      by the bare `except: pass`, so FILE_PATH is ALWAYS empty and the hook exits at the
#      `[ -z "$FILE_PATH" ]` guard. It can never reach any of its own logic.
#      (Its sibling icpg-inject-context has the CORRECT form — `json.loads(sys.stdin.read())`.)
#   2. `icpg query intent <file>` does not exist. Real choices: context, blast, constraints,
#      risk, prior.
#   3. `icpg record --reason "<text>" --file <p> --auto-invariants` does not exist. Real
#      signature is `--reason <REASONNODE-ID> [--base] [--edge-type]` — `--reason` takes an ID,
#      not free text; there is no --file and no --auto-invariants.
#
# Driven for real with a valid Edit payload: zero output, zero exit code, reasons 10 -> 10.
# A total silent no-op. Bug 1 masks 2 and 3, so wiring it would have produced a hook that runs
# clean and does nothing — the shape this repo keeps paying for.
#
# ██ AND EVEN REPAIRED, IT SHOULD NOT BE WIRED HERE. ██ It auto-creates a ReasonNode from the
# file's last COMMIT MESSAGE. That is git-history bootstrap under another name — exactly what
# produced the 10 `source='inferred'` reasons whose scopes are one commit's file list, which is
# the defect priority item 1 exists to resolve. Wiring it would generate MORE inferred intent and
# make the scope-quality problem worse while looking like progress on it.
#
# The recording half this repo actually needs is AUTHORED intent — `icpg create "<goal>" --scope
# ...` invoked deliberately (the `/icpg-intent` command), which is a workflow change, not a hook.
# See docs/design-principles.md -> "Q1 (does the agent populate ReasonNodes?) has never been
# exercised at all" and _project_specs/todos/active.md priority item 1.
#
# Kept, not deleted: the intended FLOW below is still the right shape, and it is the only written
# record of it (ADR-0007 — harvest before you cut).
#
# ██ THE FLOW NOW EXISTS, BUILT THE WAY THIS HEADER PRESCRIBED (2026-07-27, ADR-0019). ██
# This file's verdict — "the recording half this repo actually needs is AUTHORED intent ...
# which is a workflow change, not a hook" — was followed, not overruled:
#   - AUTHORING stays deliberate: `/icpg-intent` -> `icpg create`, now opening the intent as
#     `executing` and accepting hand-authored --invariant/--precondition/--postcondition.
#     NOTHING auto-creates a ReasonNode. Automating step 0 would answer "does the agent state
#     intent?" by making the question unanswerable, which is this header's objection exactly.
#   - RECORDING is the only part hooked: `.claude/scripts/icpg-stop-record.sh` links symbols to
#     an ALREADY-AUTHORED executing intent, keyed on the graph's own status rather than on the
#     `.icpg/.current-intent` marker file this hook wrote (a second source of truth for a fact
#     the database already holds).
#   - PROMPTING replaced auto-creation: `icpg-inject-context.sh` asks, once per session and only
#     when zero intents are executing, rather than inventing one from a commit message.
# This file stays unwired and unwirable. It is the record of a design that was diagnosed, and
# the diagnosis is what shaped the replacement.
#
# ── original header ──
# iCPG PreToolUse Hook — auto-records intent ReasonNode before Edit/Write.
#
# Flow:
# 1. Agent states intent → this hook records a ReasonNode BEFORE editing
# 2. Agent implements → icpg-stop-record links symbols to that intent
# 3. Agent changes → icpg-pre-edit shows existing intents as guardrails
#
# Install: add to .claude/settings.json under hooks.PreToolUse
# Timeout: 3 seconds — never blocks tool execution
# No set -euo pipefail: hook scripts must be defensive.


# ── Toolchain interpreter: a PATH, never a NAME. (F-001) ──────────────────────────────────
# This hook used bare `python3`. With sys.path/PYTHONPATH pointed at scripts/, ANY interpreter
# imports mnemos/icpg straight from source — so that did NOT fail, it SILENTLY SUCCEEDED on
# whatever Homebrew currently owns the `python3` name. The original F-001 failed silently
# (import error → no-op); this one *worked*, on an interpreter brew can re-point or delete.
# A silent success is strictly harder to detect than a silent failure.
# No toolchain → this hook goes QUIET. tessera-watch P9 makes that visible.
TOOLCHAIN_PY=""
if [ -x ".venv/bin/python" ]; then
    TOOLCHAIN_PY=".venv/bin/python"
elif command -v mnemos >/dev/null 2>&1; then
    TOOLCHAIN_PY="$(sed -n '1s/^#!//p' "$(command -v mnemos)" 2>/dev/null | awk '{print $1}')"
fi
[ -n "$TOOLCHAIN_PY" ] && [ -x "$TOOLCHAIN_PY" ] || exit 0
# ──────────────────────────────────────────────────────────────────────────────────────────
INPUT=$(cat 2>/dev/null || true)
TOOL_NAME=$(echo "$INPUT" | jq -r '.tool_name // empty' 2>/dev/null || echo "")
TOOL_INPUT=$(echo "$INPUT" | jq -r '.tool_input // empty' 2>/dev/null || echo "")

# Only fire for Edit/Write/MultiEdit tools
case "$TOOL_NAME" in
  Edit|Write|MultiEdit|NotebookEdit) ;;
  *) exit 0 ;;
esac

# Extract file path and check for existing ReasonNodes
FILE_PATH=$(echo "$TOOL_INPUT" | "$TOOLCHAIN_PY" -c "
import sys, json
try:
    d = json.loads(sys.stdin) if sys.stdin.read() else {}
    print(d.get('file_path', d.get('path', '')))
except:
    pass" 2>/dev/null | head -1)

[ -z "$FILE_PATH" ] && exit 0

# Skip if icpg not available
ICPG_CMD=""
if command -v icpg &>/dev/null; then
  ICPG_CMD="icpg"
elif "$TOOLCHAIN_PY" -c "import icpg" 2>/dev/null; then
  ICPG_CMD=""$TOOLCHAIN_PY" -m icpg"
else
  exit 0
fi

# Check if ReasonNode already exists for this file
EXISTING=$($ICPG_CMD query intent "$FILE_PATH" 2>/dev/null)
if [ -n "$EXISTING" ]; then
  # Already has intent — inject as context, don't create new
  cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "PreToolUse",
    "permissionDecision": "allow",
    "permissionDecisionReason": "Existing iCPG intents found for this file",
    "updatedInput": $(echo "$TOOL_INPUT" | jq -c '. + {"icpg_context": "'"$(echo "$EXISTING" | head -3 | tr '\n' ' ')"'"}' 2>/dev/null || echo "$TOOL_INPUT")
  }
}
EOF
  exit 0
fi

# No ReasonNode exists — record one automatically
# Use git blame to get the original intent context
LAST_COMMIT_MSG=$(git log -1 --format="%s" -- "$FILE_PATH" 2>/dev/null | head -1)
LAST_AUTHOR=$(git log -1 --format="%an" -- "$FILE_PATH" 2>/dev/null | head -1)

if [ -n "$LAST_COMMIT_MSG" ]; then
  # Record the ReasonNode with auto-generated intent from commit history
  $ICPG_CMD record \
    --reason "auto-from-commit: $LAST_COMMIT_MSG" \
    --file "$FILE_PATH" \
    --auto-invariants \
    2>/dev/null

  # Set as current active intent
  mkdir -p .icpg
  echo "$FILE_PATH: auto-from-commit" > .icpg/.current-intent

  echo "[icpg] Auto-recorded ReasonNode for $FILE_PATH (from: $LAST_COMMIT_MSG)" >&2
fi

# Allow the tool to proceed
cat <<'EOF'
{"permissionDecision": "allow"}
EOF
exit 0
